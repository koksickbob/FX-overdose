  EventID: EVENT_22_AI_SUICIDE_URGE
  ScenarioTitle: "AI \uD2B8\uB808\uC774\uB354\uC758 \uC790\uAE08 \uC99D\uBC1C(\uCCAD\uC0B0)
    \uCDA9\uB3D9"
  ScenarioDescription: "\uC218\uB9CE\uC740 \uCCAD\uC0B0\uACFC \uC2A4\uD2B8\uB808\uC2A4\uB85C
    \uC778\uD574 AI \uD2B8\uB808\uC774\uB354\uAC00 '\uC5B4\uCC28\uD53C \uB9DD\uD560
    \uAC70, \uC9C0\uAE08 \uB0A8\uC740 \uB3C8\uB9C8\uC800 100\uBC30 \uB808\uBC84\uB9AC\uC9C0\uB85C
    \uD0DC\uC6CC\uBC84\uB9AC\uACE0 \uD3B8\uD574\uC9C0\uC790'\uB294 \uC790\uAE30\uD30C\uAD34
    \uCDA9\uB3D9\uC5D0 \uD729\uC2F8\uC785\uB2C8\uB2E4."
  AIMonologue: "\uC9C0\uCCE4\uC5B4... \uB2E4 \uBD80\uC9C8\uC5C6\uC5B4... \uC5B4\uCC28\uD53C
    \uC800 \uC138\uB825\uB188\uB4E4 \uC54C\uACE0\uB9AC\uC998\uC744 \uC774\uAE38 \uC21C
    \uC5C6\uC5B4. \uADF8\uB0E5 \uB0A8\uC740 \uB3C8 100\uBC30\uB85C \uAE01\uC5B4\uBC84\uB9AC\uACE0
    \uC2A4\uC704\uCE58 \uB044\uC790... \uD3B8\uD574\uC9C0\uACE0 \uC2F6\uC5B4..."
  TriggerCondition: 2
  Options:
  - OptionType: 0
    OptionTitle: "AI\uC758 \uAD8C\uD55C\uC744 \uBC15\uD0C8\uD558\uACE0 2\uC2DC\uAC04
      \uC2DC\uC2A4\uD15C \uC167\uB2E4\uC6B4."
    Description: "\uB9E4\uB9E4 \uAC15\uC81C \uC911\uB2E8. AI\uAC00 \uC548\uC815\uC744
      \uB418\uCC3E\uACE0 \uBA58\uD0C8 +40, \uCCB4\uB825 +20 \uD68C\uBCF5."
    RequiredItemId: 
