    CustomStopLossROELimit: 0
  - OptionType: 1
    OptionTitle: "\uADF8\uB798! \uD654\uB048\uD558\uAC8C \uD0DC\uC6B0\uACE0 \uB05D\uB0B4\uC790!
      125\uBC30 \uD480\uC2DC\uB4DC \uB871!!"
    Description: "\uC790\uD3EC\uC790\uAE30 \uB9E4\uB9E4. \uC6B4 \uC88B\uAC8C +10%
      \uC218\uC775\uC774 \uB098\uAC70\uB098, 100% \uCCAD\uC0B0(-100 \uBA58\uD0C8)."
