  EventID: EVENT_15_GOLDEN_CROSS
  ScenarioTitle: "\uACE8\uB4E0\uD06C\uB85C\uC2A4 \uC9C1\uC804 \uD638\uAC00\uCC3D
    \uD5C8\uB9E4\uC218\xB7\uD5C8\uB9E4\uB3C4 \uACF5\uBC29"
  ScenarioDescription: "\uC774\uB3D9\uD3C9\uADE0\uC120 \uB2E8\uAE30\uC120\uC774 \uC7A5\uAE30\uC120\uC744
    \uC704\uB85C \uB3CC\uD30C\uD558\uB824\uB294 \uACE8\uB4E0\uD06C\uB85C\uC2A4 \uC784\uBC15
    \uC2DC\uC810, \uD638\uAC00\uCC3D\uC5D0 5000\uBE44\uD2B8\uCF54\uC778 \uADDC\uBAA8\uC758
    \uAC70\uB300 \uB9E4\uC218\uBCBD\uACFC \uB9E4\uB3C4\uBCBD\uC774 \uB3D9\uC2DC\uC5D0
    \uB4F1\uC7A5\uD574 \uADF9\uB3C4\uC758 \uB208\uCE58\uC2F8\uC6C0\uC774 \uD3BC\uCCD0\uC9D1\uB2C8\uB2E4."
  AIMonologue: "\uACE8\uB4E0\uD06C\uB85C\uC2A4 \uC9C1\uC804...! \uD638\uAC00\uCC3D
    \uC704\uC5D0 5000\uAC1C\uC9DC\uB9AC \uB9E4\uB3C4\uBCBD\uC774 \uB9C9\uACE0 \uC788\uC5B4.
    \uC800 \uB9E4\uB3C4\uBCBD\uC774 \uAC1C\uBBF8\uB97C \uCAD3\uC544\uB0B4\uB824\uB294
    \uAC00\uC9DC\uB77C\uBA74 \uC9C0\uAE08 \uB871\uC744 \uAE01\uC5B4\uC57C 1000\uBD88\uC744
    \uBA39\uC5B4!! \uD558\uC9C0\uB9CC \uC9C4\uC9DC \uC138\uB825 \uB9E4\uB3C4\uB77C\uBA74
    \uBA38\uB9AC\uD1B5 \uAE68\uC9C4\uB2E4\uACE0!! \uC5B4\uB514\uB85C \uC7A1\uC9C0?!"
  TriggerCondition: 1
