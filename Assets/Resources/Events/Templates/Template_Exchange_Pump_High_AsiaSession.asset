  TemplateID: Exchange_Pump_High_AsiaSession
  ThemeTag: "[Exchange_Pump_High_AsiaSession] \uC544\uC2DC\uC544\uC7A5 \uC2DC\uAC04\uB300,
    \uADF9\uB3C4\uC758 \uCE58\uBA85\uC801\uC778 \uAE00\uB85C\uBC8C \uB300\uD615 \uAC70\uB798\uC18C\uC758
    \uBCF4\uC548/\uBC45\uD06C\uB7F0 \uC774\uC288\uB85C \uC778\uD55C \uAC15\uB825\uD55C
    \uC0C1\uC2B9(\uD3EC\uBAA8/\uBE45\uB871) \uBE54 \uD3ED\uBC1C \uC0C1\uD669"
  FallbackTitle: "[\uAE34\uAE09] \uB300\uD615 \uAC70\uB798\uC18C \uCD9C\uAE08 \uC9C0\uC5F0\xB7\uBCF4\uC548
    \uACBD\uBCF4, \uB9E4\uC218\uC138 \uD3ED\uBC1C"
  FallbackDescription: "\uC544\uC2DC\uC544\uC7A5\uC774 \uC5F4\uB9B0 \uC9C1\uD6C4
    \uAE00\uB85C\uBC8C \uB300\uD615 \uAC70\uB798\uC18C\uAC00 \uC810\uAC80\uC744 \uC774\uC720\uB85C
    \uCD9C\uAE08\uC744 \uC9C0\uC5F0\uC2DC\uD0A4\uC790 \uBC45\uD06C\uB7F0 \uC6B0\uB824\uAC00
    \uBC88\uC9C0\uACE0 \uC788\uB2E4. \uB9E4\uC218 \uC8FC\uBB38\uC774 \uD638\uAC00\uCC3D\uC744
    \uC4F8\uC5B4\uC62C\uB9AC\uBA70 \uD3EC\uBAA8 \uC2EC\uB9AC\uAC00 \uBE60\uB974\uAC8C
    \uBC88\uC9C0\uB294 \uC911\uC774\uB2E4. \uC9C0\uAE08\uC758 \uD55C \uBC88\uC758
    \uC120\uD0DD\uC774 \uACC4\uC88C\uB97C \uD1B5\uC9F8\uB85C \uB0A0\uB9B4 \uC218\uB3C4,
    \uC0B4\uB9B4 \uC218\uB3C4 \uC788\uB2E4."
  FallbackMonologues:
  - "\uC62C\uB77C\uAC00! \uC62C\uB77C\uAC04\uB2E4\uACE0! \uADFC\uB370 \uC774\uAC70
    \uAF2D\uC9C0\uBA74 \uC5B4\uCA4C\uC9C0... \uC624\uBE60\uAC00 \uC815\uD574\uC918!"
  - "\uD638\uAC00\uCC3D\uC774 \uB2E4 \uB179\uC544\uBC84\uB838\uC5B4...! \uC624\uBE60,
    \uC774\uAC74 \uC9C4\uC9DC\uC57C? \uC544\uB2C8\uBA74 \uD568\uC815\uC774\uC57C?!"
  - "\uC2EC\uC7A5\uC774 \uD130\uC9C8 \uAC83 \uAC19\uC544! \uC9C0\uAE08 \uB4E4\uC5B4\uAC00\uBA74
    \uBA39\uB294 \uAC70 \uB9DE\uC9C0? \uB9DE\uB2E4\uACE0 \uD574\uC918 \uC624\uBE60!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uAC70\uB798\uC18C\uC5D0\uC11C \uC790\uAE08\uC744 \uBE7C\uACE0
      \uAD00\uB9DD\uD55C\uB2E4"
    OptionDescription: "\uCD9C\uAE08\uC774 \uB9C9\uD790 \uC218 \uC788\uB294 \uC704\uD5D8\uC744
      \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    RequiredItemId: 
