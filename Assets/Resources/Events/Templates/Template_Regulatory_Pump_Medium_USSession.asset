  TemplateID: Regulatory_Pump_Medium_USSession
  ThemeTag: "[Regulatory_Pump_Medium_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uC0C1\uB2F9\uD55C \uAC01\uAD6D \uC815\uBD80\uC758
    \uD06C\uB9BD\uD1A0 \uADDC\uC81C \uB610\uB294 \uC138\uAE08 \uBC95\uC548 \uBC1C\uD45C\uB85C
    \uC778\uD55C \uAC15\uB825\uD55C \uC0C1\uC2B9(\uD3EC\uBAA8/\uBE45\uB871) \uBE54
    \uD3ED\uBC1C \uC0C1\uD669"
  FallbackTitle: "[\uC18D\uBCF4] \uC815\uBD80 \uADDC\uC81C\xB7\uACFC\uC138 \uBC95\uC548
    \uBC1C\uD45C, \uB9E4\uC218\uC138 \uD3ED\uBC1C"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uAC01\uAD6D \uB2F9\uAD6D\uC774 \uB3D9\uC2DC\uB2E4\uBC1C\uC801\uC73C\uB85C \uADDC\uC81C\uC548\uC744
    \uAEBC\uB0B4\uB4E4\uBA74\uC11C \uAE30\uAD00 \uC790\uAE08\uC774 \uAD00\uB9DD\uC73C\uB85C
    \uB3CC\uC544\uC130\uB2E4. \uB9E4\uC218 \uC8FC\uBB38\uC774 \uD638\uAC00\uCC3D\uC744
    \uC4F8\uC5B4\uC62C\uB9AC\uBA70 \uD3EC\uBAA8 \uC2EC\uB9AC\uAC00 \uBE60\uB974\uAC8C
    \uBC88\uC9C0\uB294 \uC911\uC774\uB2E4. \uB808\uBC84\uB9AC\uC9C0\uB97C \uC954
    \uACC4\uC88C\uB77C\uBA74 \uC9C0\uAE08 \uD310\uB2E8\uC774 \uD558\uB8E8 \uC190\uC775\uC744
    \uAC00\uB978\uB2E4."
  FallbackMonologues:
  - "\uD638\uAC00\uCC3D\uC774 \uB2E4 \uB179\uC544\uBC84\uB838\uC5B4...! \uC624\uBE60,
    \uC774\uAC74 \uC9C4\uC9DC\uC57C? \uC544\uB2C8\uBA74 \uD568\uC815\uC774\uC57C?!"
  - "\uC2EC\uC7A5\uC774 \uD130\uC9C8 \uAC83 \uAC19\uC544! \uC9C0\uAE08 \uB4E4\uC5B4\uAC00\uBA74
    \uBA39\uB294 \uAC70 \uB9DE\uC9C0? \uB9DE\uB2E4\uACE0 \uD574\uC918 \uC624\uBE60!"
  - "\uAC70\uB798\uB7C9\uC774 \uBBF8\uCCE4\uC5B4... \uC774\uB7F0 \uAC74 \uCC98\uC74C
    \uBD10. \uC624\uBE60, \uC694\uBBF8 \uBB34\uC11C\uC6CC. \uC5B4\uB5A1\uD560 \uAC70\uC57C?"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uBC95\uC548 \uC724\uACFD\uC774 \uC7A1\uD790 \uB54C\uAE4C\uC9C0
      \uD604\uAE08 \uBCF4\uC720"
    OptionDescription: "\uADDC\uC81C \uC724\uACFD\uC774 \uC548 \uC7A1\uD78C \uAD6C\uAC04\uC744
      \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
