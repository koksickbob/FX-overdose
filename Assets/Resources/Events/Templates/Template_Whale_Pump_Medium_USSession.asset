  TemplateID: Whale_Pump_Medium_USSession
  ThemeTag: "[Whale_Pump_Medium_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uC0C1\uB2F9\uD55C \uCD08\uAC70\uB300 \uACE0\uB798
    \uC9C0\uAC11\uC758 \uB300\uADDC\uBAA8 \uBB3C\uB7C9 \uC774\uB3D9\uC73C\uB85C \uC778\uD55C
    \uAC15\uB825\uD55C \uC0C1\uC2B9(\uD3EC\uBAA8/\uBE45\uB871) \uBE54 \uD3ED\uBC1C
    \uC0C1\uD669"
  FallbackTitle: "[\uC18D\uBCF4] \uCD08\uB300\uD615 \uACE0\uB798 \uC9C0\uAC11 \uB300\uB7C9
    \uBB3C\uB7C9 \uC774\uB3D9, \uB9E4\uC218\uC138 \uD3ED\uBC1C"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uC7A5\uAE30 \uD734\uBA74 \uC0C1\uD0DC\uC600\uB358 \uACE0\uB798 \uC9C0\uAC11\uC5D0\uC11C
    \uC815\uCCB4\uBD88\uBA85\uC758 \uC8FC\uC18C\uB85C \uB300\uADDC\uBAA8 \uBB3C\uB7C9\uC774
    \uC62E\uACA8\uC84C\uB2E4. \uB9E4\uC218 \uC8FC\uBB38\uC774 \uD638\uAC00\uCC3D\uC744
    \uC4F8\uC5B4\uC62C\uB9AC\uBA70 \uD3EC\uBAA8 \uC2EC\uB9AC\uAC00 \uBE60\uB974\uAC8C
    \uBC88\uC9C0\uB294 \uC911\uC774\uB2E4. \uB808\uBC84\uB9AC\uC9C0\uB97C \uC954
    \uACC4\uC88C\uB77C\uBA74 \uC9C0\uAE08 \uD310\uB2E8\uC774 \uD558\uB8E8 \uC190\uC775\uC744
    \uAC00\uB978\uB2E4."
  FallbackMonologues:
  - "\uAC70\uB798\uB7C9\uC774 \uBBF8\uCCE4\uC5B4... \uC774\uB7F0 \uAC74 \uCC98\uC74C
    \uBD10. \uC624\uBE60, \uC694\uBBF8 \uBB34\uC11C\uC6CC. \uC5B4\uB5A1\uD560 \uAC70\uC57C?"
  - "\uC624\uBE60...! \uC9C0\uAE08 \uC548 \uD0C0\uBA74 \uC774\uAC70 \uB193\uCE58\uB294
    \uAC70\uC57C! \uC5B4\uB5A1\uD574, \uBE68\uB9AC \uC815\uD574\uC918!"
  - "\uC62C\uB77C\uAC00! \uC62C\uB77C\uAC04\uB2E4\uACE0! \uADFC\uB370 \uC774\uAC70
    \uAF2D\uC9C0\uBA74 \uC5B4\uCA4C\uC9C0... \uC624\uBE60\uAC00 \uC815\uD574\uC918!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uBB3C\uB7C9\uC774 \uC18C\uD654\uB420 \uB54C\uAE4C\uC9C0 \uC190\uC744
