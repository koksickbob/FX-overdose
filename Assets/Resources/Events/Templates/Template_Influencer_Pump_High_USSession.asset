  TemplateID: Influencer_Pump_High_USSession
  ThemeTag: "[Influencer_Pump_High_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uADF9\uB3C4\uC758 \uCE58\uBA85\uC801\uC778 \uC720\uBA85
    \uC778\uD50C\uB8E8\uC5B8\uC11C\uC758 \uAE30\uC2B5\uC801\uC778 SNS \uBC1C\uC5B8\uC73C\uB85C
    \uC778\uD55C \uAC15\uB825\uD55C \uC0C1\uC2B9(\uD3EC\uBAA8/\uBE45\uB871) \uBE54
    \uD3ED\uBC1C \uC0C1\uD669"
  FallbackTitle: "[\uAE34\uAE09] \uC720\uBA85 \uC778\uD50C\uB8E8\uC5B8\uC11C \uAE30\uC2B5
    \uBC1C\uC5B8, \uB9E4\uC218\uC138 \uD3ED\uBC1C"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uC218\uBC31\uB9CC \uD314\uB85C\uC6CC\uB97C \uAC00\uC9C4 \uC778\uD50C\uB8E8\uC5B8\uC11C\uAC00
    \uC608\uACE0 \uC5C6\uC774 \uC2DC\uC7A5\uC744 \uACA8\uB0E5\uD55C \uAE00\uC744
    \uC62C\uB838\uB2E4. \uB9E4\uC218 \uC8FC\uBB38\uC774 \uD638\uAC00\uCC3D\uC744
    \uC4F8\uC5B4\uC62C\uB9AC\uBA70 \uD3EC\uBAA8 \uC2EC\uB9AC\uAC00 \uBE60\uB974\uAC8C
    \uBC88\uC9C0\uB294 \uC911\uC774\uB2E4. \uC9C0\uAE08\uC758 \uD55C \uBC88\uC758
    \uC120\uD0DD\uC774 \uACC4\uC88C\uB97C \uD1B5\uC9F8\uB85C \uB0A0\uB9B4 \uC218\uB3C4,
    \uC0B4\uB9B4 \uC218\uB3C4 \uC788\uB2E4."
  FallbackMonologues:
  - "\uC2EC\uC7A5\uC774 \uD130\uC9C8 \uAC83 \uAC19\uC544! \uC9C0\uAE08 \uB4E4\uC5B4\uAC00\uBA74
    \uBA39\uB294 \uAC70 \uB9DE\uC9C0? \uB9DE\uB2E4\uACE0 \uD574\uC918 \uC624\uBE60!"
  - "\uAC70\uB798\uB7C9\uC774 \uBBF8\uCCE4\uC5B4... \uC774\uB7F0 \uAC74 \uCC98\uC74C
    \uBD10. \uC624\uBE60, \uC694\uBBF8 \uBB34\uC11C\uC6CC. \uC5B4\uB5A1\uD560 \uAC70\uC57C?"
  - "\uC624\uBE60...! \uC9C0\uAE08 \uC548 \uD0C0\uBA74 \uC774\uAC70 \uB193\uCE58\uB294
    \uAC70\uC57C! \uC5B4\uB5A1\uD574, \uBE68\uB9AC \uC815\uD574\uC918!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uB9D0\uC5D0 \uD718\uB458\uB9AC\uC9C0 \uC54A\uACE0 \uD3EC\uC9C0\uC158\uC744
      \uC811\uB294\uB2E4"
    OptionDescription: "\uB9D0 \uD55C\uB9C8\uB514\uC5D0 \uD729\uC4F8\uB9B4 \uC704\uD5D8\uC744
      \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
