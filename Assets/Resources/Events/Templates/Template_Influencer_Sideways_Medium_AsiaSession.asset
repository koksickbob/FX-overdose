  ThemeTag: "[Influencer_Sideways_Medium_AsiaSession] \uC544\uC2DC\uC544\uC7A5 \uC2DC\uAC04\uB300,
    \uC0C1\uB2F9\uD55C \uC720\uBA85 \uC778\uD50C\uB8E8\uC5B8\uC11C\uC758 \uAE30\uC2B5\uC801\uC778
    SNS \uBC1C\uC5B8\uC73C\uB85C \uC778\uD55C \uADF9\uB3C4\uC758 \uB208\uCE58\uC2F8\uC6C0\uACFC
    \uC228\uB9C9\uD788\uB294 \uD6A1\uBCF4\uC7A5 \uC0C1\uD669"
  FallbackTitle: "[\uC18D\uBCF4] \uC720\uBA85 \uC778\uD50C\uB8E8\uC5B8\uC11C \uAE30\uC2B5
    \uBC1C\uC5B8, \uAC70\uB798\uB7C9 \uC2E4\uC885 \uB208\uCE58\uC2F8\uC6C0"
  FallbackDescription: "\uC544\uC2DC\uC544\uC7A5\uC774 \uC5F4\uB9B0 \uC9C1\uD6C4
    \uC218\uBC31\uB9CC \uD314\uB85C\uC6CC\uB97C \uAC00\uC9C4 \uC778\uD50C\uB8E8\uC5B8\uC11C\uAC00
    \uC608\uACE0 \uC5C6\uC774 \uC2DC\uC7A5\uC744 \uACA8\uB0E5\uD55C \uAE00\uC744
    \uC62C\uB838\uB2E4. \uC591\uCE21 \uBAA8\uB450 \uBC29\uD5A5\uC744 \uD655\uC2E0\uD558\uC9C0
    \uBABB\uD574 \uAC70\uB798\uB7C9\uC774 \uB9C8\uB974\uACE0 \uBCC0\uB3D9\uC131\uB9CC
    \uC751\uCD95\uB418\uACE0 \uC788\uB2E4. \uB808\uBC84\uB9AC\uC9C0\uB97C \uC954
    \uACC4\uC88C\uB77C\uBA74 \uC9C0\uAE08 \uD310\uB2E8\uC774 \uD558\uB8E8 \uC190\uC775\uC744
    \uAC00\uB978\uB2E4."
  FallbackMonologues:
  - "\uC228 \uB9C9\uD600... \uAC70\uB798\uB7C9\uC774 \uC644\uC804\uD788 \uB9D0\uB790\uC5B4.
    \uC774\uB7F4 \uB54C\uAC00 \uC81C\uC77C \uBB34\uC11C\uC6B4\uB370."
  - "\uC591\uCABD \uB2E4 \uB208\uCE58\uB9CC \uBCF4\uACE0 \uC788\uC5B4. \uC624\uBE60,
    \uC6B0\uB9AC\uB294 \uC5B4\uB290 \uCABD\uC5D0 \uC124 \uAC70\uC57C?"
  - "\uBCC0\uB3D9\uC131\uC774 \uC751\uCD95\uB418\uACE0 \uC788\uC5B4... \uD130\uC9C0\uBA74
    \uD55C\uCABD\uC73C\uB85C \uD06C\uAC8C \uAC08 \uAC70\uC57C. \uC900\uBE44\uD574\uC57C
    \uD574!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uB9D0\uC5D0 \uD718\uB458\uB9AC\uC9C0 \uC54A\uACE0 \uD3EC\uC9C0\uC158\uC744
      \uC811\uB294\uB2E4"
    OptionDescription: "\uB9D0 \uD55C\uB9C8\uB514\uC5D0 \uD729\uC4F8\uB9B4 \uC704\uD5D8\uC744
      \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
