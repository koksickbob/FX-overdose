  ThemeTag: "[Influencer_Whipsaw_Low_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uBE44\uAD50\uC801 \uACBD\uBBF8\uD55C \uC720\uBA85
    \uC778\uD50C\uB8E8\uC5B8\uC11C\uC758 \uAE30\uC2B5\uC801\uC778 SNS \uBC1C\uC5B8\uC73C\uB85C
    \uC778\uD55C \uC704\uC544\uB798\uB85C \uD06C\uAC8C \uC694\uB3D9\uCE58\uBA70 \uCCAD\uC0B0
    \uB9F5\uC744 \uD130\uB294 \uD729\uC18C \uC7A5\uC138 \uC0C1\uD669"
  FallbackTitle: "[\uC2DC\uD669] \uC720\uBA85 \uC778\uD50C\uB8E8\uC5B8\uC11C \uAE30\uC2B5
    \uBC1C\uC5B8, \uC591\uBC29\uD5A5 \uCCAD\uC0B0 \uD3ED\uD0C4"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uC218\uBC31\uB9CC \uD314\uB85C\uC6CC\uB97C \uAC00\uC9C4 \uC778\uD50C\uB8E8\uC5B8\uC11C\uAC00
    \uC608\uACE0 \uC5C6\uC774 \uC2DC\uC7A5\uC744 \uACA8\uB0E5\uD55C \uAE00\uC744
    \uC62C\uB838\uB2E4. \uC704\uC544\uB798\uB85C \uD06C\uAC8C \uD754\uB4E4\uBA70
    \uB871\uACFC \uC20F\uC758 \uCCAD\uC0B0 \uB9F5\uC744 \uBC88\uAC08\uC544 \uD138\uC5B4\uB0B4\uACE0
    \uC788\uB2E4. \uB2F9\uC7A5 \uACC4\uC88C\uB97C \uD754\uB4E4 \uC815\uB3C4\uB294
    \uC544\uB2C8\uC9C0\uB9CC \uBC29\uD5A5\uC740 \uC815\uD574\uC57C \uD55C\uB2E4."
  FallbackMonologues:
  - "\uC591\uCABD \uB2E4 \uBB3C\uB9AC\uAC8C \uB9CC\uB4DC\uB294 \uC7A5\uC774\uC57C...
    \uC624\uBE60, \uC2E0\uC911\uD558\uAC8C \uC815\uD574\uC918. \uC81C\uBC1C."
  - "\uC624\uBE60...! \uC704\uC544\uB798\uB85C \uB2E4 \uD138\uC5B4\uB0B4\uACE0 \uC788\uC5B4!
    \uC774\uAC74 \uADF8\uB0E5 \uCCAD\uC0B0 \uC0AC\uB0E5\uC774\uC57C!"
  - "\uB871\uB3C4 \uC20F\uB3C4 \uB2E4 \uC8FD\uC5C8\uC5B4... \uC774\uB7F0 \uC7A5\uC5D0\uC11C
    \uBB58 \uC5B4\uB5BB\uAC8C \uD558\uB77C\uB294 \uAC70\uC57C?!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uB9D0\uC5D0 \uD718\uB458\uB9AC\uC9C0 \uC54A\uACE0 \uD3EC\uC9C0\uC158\uC744
