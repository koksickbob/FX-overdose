  TemplateID: OnChain_Whipsaw_Medium_USSession
  ThemeTag: "[OnChain_Whipsaw_Medium_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uC0C1\uB2F9\uD55C \uC628\uCCB4\uC778 \uB370\uC774\uD130
    \uC0C1\uC758 \uBE44\uC815\uC0C1\uC801\uC778 \uBBF8\uACB0\uC81C\uC57D\uC815(OI)
    \uD3ED\uC99D\uC73C\uB85C \uC778\uD55C \uC704\uC544\uB798\uB85C \uD06C\uAC8C \uC694\uB3D9\uCE58\uBA70
    \uCCAD\uC0B0 \uB9F5\uC744 \uD130\uB294 \uD729\uC18C \uC7A5\uC138 \uC0C1\uD669"
  FallbackTitle: "[\uC18D\uBCF4] \uBBF8\uACB0\uC81C\uC57D\uC815 \uBE44\uC815\uC0C1
    \uD3ED\uC99D, \uC591\uBC29\uD5A5 \uCCAD\uC0B0 \uD3ED\uD0C4"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uC628\uCCB4\uC778 \uC9C0\uD45C\uC0C1 \uBBF8\uACB0\uC81C\uC57D\uC815\uC774 \uB2E8\uAE30\uAC04\uC5D0
    \uBE44\uC815\uC0C1\uC801\uC73C\uB85C \uBD80\uD480\uC5B4 \uC62C\uB790\uB2E4. \uC704\uC544\uB798\uB85C
    \uD06C\uAC8C \uD754\uB4E4\uBA70 \uB871\uACFC \uC20F\uC758 \uCCAD\uC0B0 \uB9F5\uC744
    \uBC88\uAC08\uC544 \uD138\uC5B4\uB0B4\uACE0 \uC788\uB2E4. \uB808\uBC84\uB9AC\uC9C0\uB97C
    \uC954 \uACC4\uC88C\uB77C\uBA74 \uC9C0\uAE08 \uD310\uB2E8\uC774 \uD558\uB8E8
    \uC190\uC775\uC744 \uAC00\uB978\uB2E4."
  FallbackMonologues:
  - "\uB871\uB3C4 \uC20F\uB3C4 \uB2E4 \uC8FD\uC5C8\uC5B4... \uC774\uB7F0 \uC7A5\uC5D0\uC11C
    \uBB58 \uC5B4\uB5BB\uAC8C \uD558\uB77C\uB294 \uAC70\uC57C?!"
  - "\uC18D\uC9C0 \uB9C8 \uC624\uBE60! \uC774\uAC70 \uC704\uB85C \uD55C \uBC88 \uBCF4\uC5EC\uC8FC\uACE0
    \uBC11\uC73C\uB85C \uAF42\uC744 \uAC70\uC57C!"
  - "\uC2EC\uC9C0\uAC00 \uC774\uB807\uAC8C \uAE38\uB2E4\uACE0?! \uC624\uBE60, \uC5EC\uAE30
    \uB4E4\uC5B4\uAC00\uBA74 \uC9C4\uC9DC \uC704\uD5D8\uD574...!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uACFC\uC5F4\uB41C \uC57D\uC815\uC774 \uC2DD\uC744 \uB54C\uAE4C\uC9C0
      \uAE30\uB2E4\uB9B0\uB2E4"
    OptionDescription: "\uCCAD\uC0B0\uC774 \uC5F0\uC1C4\uB420 \uACFC\uC5F4 \uAD6C\uAC04\uC744
      \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
