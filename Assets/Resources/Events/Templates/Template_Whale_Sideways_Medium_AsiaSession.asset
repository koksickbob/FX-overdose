  ThemeTag: "[Whale_Sideways_Medium_AsiaSession] \uC544\uC2DC\uC544\uC7A5 \uC2DC\uAC04\uB300,
    \uC0C1\uB2F9\uD55C \uCD08\uAC70\uB300 \uACE0\uB798 \uC9C0\uAC11\uC758 \uB300\uADDC\uBAA8
    \uBB3C\uB7C9 \uC774\uB3D9\uC73C\uB85C \uC778\uD55C \uADF9\uB3C4\uC758 \uB208\uCE58\uC2F8\uC6C0\uACFC
    \uC228\uB9C9\uD788\uB294 \uD6A1\uBCF4\uC7A5 \uC0C1\uD669"
  FallbackTitle: "[\uC18D\uBCF4] \uCD08\uB300\uD615 \uACE0\uB798 \uC9C0\uAC11 \uB300\uB7C9
    \uBB3C\uB7C9 \uC774\uB3D9, \uAC70\uB798\uB7C9 \uC2E4\uC885 \uB208\uCE58\uC2F8\uC6C0"
  FallbackDescription: "\uC544\uC2DC\uC544\uC7A5\uC774 \uC5F4\uB9B0 \uC9C1\uD6C4
    \uC7A5\uAE30 \uD734\uBA74 \uC0C1\uD0DC\uC600\uB358 \uACE0\uB798 \uC9C0\uAC11\uC5D0\uC11C
    \uC815\uCCB4\uBD88\uBA85\uC758 \uC8FC\uC18C\uB85C \uB300\uADDC\uBAA8 \uBB3C\uB7C9\uC774
    \uC62E\uACA8\uC84C\uB2E4. \uC591\uCE21 \uBAA8\uB450 \uBC29\uD5A5\uC744 \uD655\uC2E0\uD558\uC9C0
    \uBABB\uD574 \uAC70\uB798\uB7C9\uC774 \uB9C8\uB974\uACE0 \uBCC0\uB3D9\uC131\uB9CC
    \uC751\uCD95\uB418\uACE0 \uC788\uB2E4. \uB808\uBC84\uB9AC\uC9C0\uB97C \uC954
    \uACC4\uC88C\uB77C\uBA74 \uC9C0\uAE08 \uD310\uB2E8\uC774 \uD558\uB8E8 \uC190\uC775\uC744
    \uAC00\uB978\uB2E4."
  FallbackMonologues:
  - "\uC228 \uB9C9\uD600... \uAC70\uB798\uB7C9\uC774 \uC644\uC804\uD788 \uB9D0\uB790\uC5B4.
    \uC774\uB7F4 \uB54C\uAC00 \uC81C\uC77C \uBB34\uC11C\uC6B4\uB370."
  - "\uC591\uCABD \uB2E4 \uB208\uCE58\uB9CC \uBCF4\uACE0 \uC788\uC5B4. \uC624\uBE60,
    \uC6B0\uB9AC\uB294 \uC5B4\uB290 \uCABD\uC5D0 \uC124 \uAC70\uC57C?"
  - "\uBCC0\uB3D9\uC131\uC774 \uC751\uCD95\uB418\uACE0 \uC788\uC5B4... \uD130\uC9C0\uBA74
    \uD55C\uCABD\uC73C\uB85C \uD06C\uAC8C \uAC08 \uAC70\uC57C. \uC900\uBE44\uD574\uC57C
    \uD574!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uBB3C\uB7C9\uC774 \uC18C\uD654\uB420 \uB54C\uAE4C\uC9C0 \uC190\uC744
      \uB5C0\uB2E4"
    OptionDescription: "\uACE0\uB798 \uBB3C\uB7C9\uC774 \uC3DF\uC544\uC9C8 \uC704\uD5D8\uC744
