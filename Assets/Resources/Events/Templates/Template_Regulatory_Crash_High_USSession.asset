  TemplateID: Regulatory_Crash_High_USSession
  ThemeTag: "[Regulatory_Crash_High_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uADF9\uB3C4\uC758 \uCE58\uBA85\uC801\uC778 \uAC01\uAD6D
    \uC815\uBD80\uC758 \uD06C\uB9BD\uD1A0 \uADDC\uC81C \uB610\uB294 \uC138\uAE08
    \uBC95\uC548 \uBC1C\uD45C\uB85C \uC778\uD55C \uACF5\uD3EC\uC758 \uC5F0\uC1C4
    \uD558\uB77D(\uD328\uB2C9\uC140/\uBE45\uC20F) \uBE54 \uD3ED\uB77D \uC0C1\uD669"
  FallbackTitle: "[\uAE34\uAE09] \uC815\uBD80 \uADDC\uC81C\xB7\uACFC\uC138 \uBC95\uC548
    \uBC1C\uD45C, \uD328\uB2C9\uC140 \uC5F0\uC1C4 \uD558\uB77D"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uAC01\uAD6D \uB2F9\uAD6D\uC774 \uB3D9\uC2DC\uB2E4\uBC1C\uC801\uC73C\uB85C \uADDC\uC81C\uC548\uC744
    \uAEBC\uB0B4\uB4E4\uBA74\uC11C \uAE30\uAD00 \uC790\uAE08\uC774 \uAD00\uB9DD\uC73C\uB85C
    \uB3CC\uC544\uC130\uB2E4. \uC190\uC808 \uBB3C\uB7C9\uC774 \uC190\uC808\uC744
    \uBD80\uB974\uBA70 \uD558\uBC29\uC73C\uB85C \uACC4\uB2E8\uC2DD \uAE09\uB77D\uC774
    \uC774\uC5B4\uC9C0\uACE0 \uC788\uB2E4. \uC9C0\uAE08\uC758 \uD55C \uBC88\uC758
    \uC120\uD0DD\uC774 \uACC4\uC88C\uB97C \uD1B5\uC9F8\uB85C \uB0A0\uB9B4 \uC218\uB3C4,
    \uC0B4\uB9B4 \uC218\uB3C4 \uC788\uB2E4."
  FallbackMonologues:
  - "\uBC11\uC774 \uC548 \uBCF4\uC5EC... \uBC1B\uCCD0\uC904 \uB9E4\uC218\uBCBD\uC774
    \uD558\uB098\uB3C4 \uC5C6\uC5B4! \uC5B4\uB5BB\uAC8C \uD574\uC57C \uB3FC?!"
  - "\uC694\uBBF8 \uACC4\uC0B0\uC774 \uB2E4 \uD2C0\uB838\uC5B4... \uC624\uBE60\uAC00
    \uB300\uC2E0 \uC815\uD574\uC918. \uC704\uC57C, \uC544\uB798\uC57C?!"
  - "\uC190\uC808 \uBB3C\uB7C9\uC774 \uC190\uC808\uC744 \uBD80\uB974\uACE0 \uC788\uC5B4...!
    \uC5EC\uAE30\uC11C \uBC84\uD2F0\uB294 \uAC8C \uB9DE\uC544, \uC624\uBE60?"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uBC95\uC548 \uC724\uACFD\uC774 \uC7A1\uD790 \uB54C\uAE4C\uC9C0
