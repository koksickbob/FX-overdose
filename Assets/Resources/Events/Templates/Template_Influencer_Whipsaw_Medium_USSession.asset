  TemplateID: Influencer_Whipsaw_Medium_USSession
  ThemeTag: "[Influencer_Whipsaw_Medium_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uC0C1\uB2F9\uD55C \uC720\uBA85 \uC778\uD50C\uB8E8\uC5B8\uC11C\uC758
    \uAE30\uC2B5\uC801\uC778 SNS \uBC1C\uC5B8\uC73C\uB85C \uC778\uD55C \uC704\uC544\uB798\uB85C
    \uD06C\uAC8C \uC694\uB3D9\uCE58\uBA70 \uCCAD\uC0B0 \uB9F5\uC744 \uD130\uB294
    \uD729\uC18C \uC7A5\uC138 \uC0C1\uD669"
  FallbackTitle: "[\uC18D\uBCF4] \uC720\uBA85 \uC778\uD50C\uB8E8\uC5B8\uC11C \uAE30\uC2B5
    \uBC1C\uC5B8, \uC591\uBC29\uD5A5 \uCCAD\uC0B0 \uD3ED\uD0C4"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uC218\uBC31\uB9CC \uD314\uB85C\uC6CC\uB97C \uAC00\uC9C4 \uC778\uD50C\uB8E8\uC5B8\uC11C\uAC00
    \uC608\uACE0 \uC5C6\uC774 \uC2DC\uC7A5\uC744 \uACA8\uB0E5\uD55C \uAE00\uC744
    \uC62C\uB838\uB2E4. \uC704\uC544\uB798\uB85C \uD06C\uAC8C \uD754\uB4E4\uBA70
    \uB871\uACFC \uC20F\uC758 \uCCAD\uC0B0 \uB9F5\uC744 \uBC88\uAC08\uC544 \uD138\uC5B4\uB0B4\uACE0
    \uC788\uB2E4. \uB808\uBC84\uB9AC\uC9C0\uB97C \uC954 \uACC4\uC88C\uB77C\uBA74
    \uC9C0\uAE08 \uD310\uB2E8\uC774 \uD558\uB8E8 \uC190\uC775\uC744 \uAC00\uB978\uB2E4."
  FallbackMonologues:
  - "\uB871\uB3C4 \uC20F\uB3C4 \uB2E4 \uC8FD\uC5C8\uC5B4... \uC774\uB7F0 \uC7A5\uC5D0\uC11C
    \uBB58 \uC5B4\uB5BB\uAC8C \uD558\uB77C\uB294 \uAC70\uC57C?!"
  - "\uC18D\uC9C0 \uB9C8 \uC624\uBE60! \uC774\uAC70 \uC704\uB85C \uD55C \uBC88 \uBCF4\uC5EC\uC8FC\uACE0
    \uBC11\uC73C\uB85C \uAF42\uC744 \uAC70\uC57C!"
  - "\uC2EC\uC9C0\uAC00 \uC774\uB807\uAC8C \uAE38\uB2E4\uACE0?! \uC624\uBE60, \uC5EC\uAE30
    \uB4E4\uC5B4\uAC00\uBA74 \uC9C4\uC9DC \uC704\uD5D8\uD574...!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uB9D0\uC5D0 \uD718\uB458\uB9AC\uC9C0 \uC54A\uACE0 \uD3EC\uC9C0\uC158\uC744
      \uC811\uB294\uB2E4"
    OptionDescription: "\uB9D0 \uD55C\uB9C8\uB514\uC5D0 \uD729\uC4F8\uB9B4 \uC704\uD5D8\uC744
      \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
