  TemplateID: Altcoin_Whipsaw_High_USSession
  ThemeTag: "[Altcoin_Whipsaw_High_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uADF9\uB3C4\uC758 \uCE58\uBA85\uC801\uC778 \uC8FC\uC694
    \uC54C\uD2B8\uCF54\uC778 \uB124\uD2B8\uC6CC\uD06C \uB9C8\uBE44 \uBC0F \uB514\uD398\uAE45
    \uC0AC\uD0DC\uB85C \uC778\uD55C \uC704\uC544\uB798\uB85C \uD06C\uAC8C \uC694\uB3D9\uCE58\uBA70
    \uCCAD\uC0B0 \uB9F5\uC744 \uD130\uB294 \uD729\uC18C \uC7A5\uC138 \uC0C1\uD669"
  FallbackTitle: "[\uAE34\uAE09] \uC8FC\uC694 \uC54C\uD2B8\uCF54\uC778 \uB124\uD2B8\uC6CC\uD06C
    \uB9C8\uBE44, \uC591\uBC29\uD5A5 \uCCAD\uC0B0 \uD3ED\uD0C4"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uC8FC\uC694 \uC54C\uD2B8\uCF54\uC778 \uB124\uD2B8\uC6CC\uD06C\uAC00 \uBA48\uCD94\uACE0
    \uC2A4\uD14C\uC774\uBE14\uCF54\uC778 \uB514\uD398\uAE45 \uC6B0\uB824\uAE4C\uC9C0
    \uACB9\uCCE4\uB2E4. \uC704\uC544\uB798\uB85C \uD06C\uAC8C \uD754\uB4E4\uBA70
    \uB871\uACFC \uC20F\uC758 \uCCAD\uC0B0 \uB9F5\uC744 \uBC88\uAC08\uC544 \uD138\uC5B4\uB0B4\uACE0
    \uC788\uB2E4. \uC9C0\uAE08\uC758 \uD55C \uBC88\uC758 \uC120\uD0DD\uC774 \uACC4\uC88C\uB97C
    \uD1B5\uC9F8\uB85C \uB0A0\uB9B4 \uC218\uB3C4, \uC0B4\uB9B4 \uC218\uB3C4 \uC788\uB2E4."
  FallbackMonologues:
  - "\uC624\uBE60...! \uC704\uC544\uB798\uB85C \uB2E4 \uD138\uC5B4\uB0B4\uACE0 \uC788\uC5B4!
    \uC774\uAC74 \uADF8\uB0E5 \uCCAD\uC0B0 \uC0AC\uB0E5\uC774\uC57C!"
  - "\uB871\uB3C4 \uC20F\uB3C4 \uB2E4 \uC8FD\uC5C8\uC5B4... \uC774\uB7F0 \uC7A5\uC5D0\uC11C
    \uBB58 \uC5B4\uB5BB\uAC8C \uD558\uB77C\uB294 \uAC70\uC57C?!"
  - "\uC18D\uC9C0 \uB9C8 \uC624\uBE60! \uC774\uAC70 \uC704\uB85C \uD55C \uBC88 \uBCF4\uC5EC\uC8FC\uACE0
    \uBC11\uC73C\uB85C \uAF42\uC744 \uAC70\uC57C!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uC54C\uD2B8\uB97C \uC815\uB9AC\uD558\uACE0 \uC0AC\uD0DC\uB97C
