  TemplateID: Exchange_Crash_Medium_USSession
  ThemeTag: "[Exchange_Crash_Medium_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uC0C1\uB2F9\uD55C \uAE00\uB85C\uBC8C \uB300\uD615
    \uAC70\uB798\uC18C\uC758 \uBCF4\uC548/\uBC45\uD06C\uB7F0 \uC774\uC288\uB85C \uC778\uD55C
    \uACF5\uD3EC\uC758 \uC5F0\uC1C4 \uD558\uB77D(\uD328\uB2C9\uC140/\uBE45\uC20F)
    \uBE54 \uD3ED\uB77D \uC0C1\uD669"
  FallbackTitle: "[\uC18D\uBCF4] \uB300\uD615 \uAC70\uB798\uC18C \uCD9C\uAE08 \uC9C0\uC5F0\xB7\uBCF4\uC548
    \uACBD\uBCF4, \uD328\uB2C9\uC140 \uC5F0\uC1C4 \uD558\uB77D"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uAE00\uB85C\uBC8C \uB300\uD615 \uAC70\uB798\uC18C\uAC00 \uC810\uAC80\uC744 \uC774\uC720\uB85C
    \uCD9C\uAE08\uC744 \uC9C0\uC5F0\uC2DC\uD0A4\uC790 \uBC45\uD06C\uB7F0 \uC6B0\uB824\uAC00
    \uBC88\uC9C0\uACE0 \uC788\uB2E4. \uC190\uC808 \uBB3C\uB7C9\uC774 \uC190\uC808\uC744
    \uBD80\uB974\uBA70 \uD558\uBC29\uC73C\uB85C \uACC4\uB2E8\uC2DD \uAE09\uB77D\uC774
    \uC774\uC5B4\uC9C0\uACE0 \uC788\uB2E4. \uB808\uBC84\uB9AC\uC9C0\uB97C \uC954
    \uACC4\uC88C\uB77C\uBA74 \uC9C0\uAE08 \uD310\uB2E8\uC774 \uD558\uB8E8 \uC190\uC775\uC744
    \uAC00\uB978\uB2E4."
  FallbackMonologues:
  - "\uC548 \uB3FC... \uC774 \uC18D\uB3C4\uBA74 \uCCAD\uC0B0\uC774\uC57C. \uC624\uBE60,
    \uC81C\uBC1C \uBE68\uB9AC \uC815\uD574\uC918...!"
  - "\uBC11\uC774 \uC548 \uBCF4\uC5EC... \uBC1B\uCCD0\uC904 \uB9E4\uC218\uBCBD\uC774
    \uD558\uB098\uB3C4 \uC5C6\uC5B4! \uC5B4\uB5BB\uAC8C \uD574\uC57C \uB3FC?!"
  - "\uC694\uBBF8 \uACC4\uC0B0\uC774 \uB2E4 \uD2C0\uB838\uC5B4... \uC624\uBE60\uAC00
    \uB300\uC2E0 \uC815\uD574\uC918. \uC704\uC57C, \uC544\uB798\uC57C?!"
  LogicOptions:
  - OptionType: 0
