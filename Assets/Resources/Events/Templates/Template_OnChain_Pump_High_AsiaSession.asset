  TemplateID: OnChain_Pump_High_AsiaSession
  ThemeTag: "[OnChain_Pump_High_AsiaSession] \uC544\uC2DC\uC544\uC7A5 \uC2DC\uAC04\uB300,
    \uADF9\uB3C4\uC758 \uCE58\uBA85\uC801\uC778 \uC628\uCCB4\uC778 \uB370\uC774\uD130
    \uC0C1\uC758 \uBE44\uC815\uC0C1\uC801\uC778 \uBBF8\uACB0\uC81C\uC57D\uC815(OI)
    \uD3ED\uC99D\uC73C\uB85C \uC778\uD55C \uAC15\uB825\uD55C \uC0C1\uC2B9(\uD3EC\uBAA8/\uBE45\uB871)
    \uBE54 \uD3ED\uBC1C \uC0C1\uD669"
  FallbackTitle: "[\uAE34\uAE09] \uBBF8\uACB0\uC81C\uC57D\uC815 \uBE44\uC815\uC0C1
    \uD3ED\uC99D, \uB9E4\uC218\uC138 \uD3ED\uBC1C"
  FallbackDescription: "\uC544\uC2DC\uC544\uC7A5\uC774 \uC5F4\uB9B0 \uC9C1\uD6C4
    \uC628\uCCB4\uC778 \uC9C0\uD45C\uC0C1 \uBBF8\uACB0\uC81C\uC57D\uC815\uC774 \uB2E8\uAE30\uAC04\uC5D0
    \uBE44\uC815\uC0C1\uC801\uC73C\uB85C \uBD80\uD480\uC5B4 \uC62C\uB790\uB2E4. \uB9E4\uC218
    \uC8FC\uBB38\uC774 \uD638\uAC00\uCC3D\uC744 \uC4F8\uC5B4\uC62C\uB9AC\uBA70 \uD3EC\uBAA8
    \uC2EC\uB9AC\uAC00 \uBE60\uB974\uAC8C \uBC88\uC9C0\uB294 \uC911\uC774\uB2E4.
    \uC9C0\uAE08\uC758 \uD55C \uBC88\uC758 \uC120\uD0DD\uC774 \uACC4\uC88C\uB97C
    \uD1B5\uC9F8\uB85C \uB0A0\uB9B4 \uC218\uB3C4, \uC0B4\uB9B4 \uC218\uB3C4 \uC788\uB2E4."
  FallbackMonologues:
  - "\uC624\uBE60...! \uC9C0\uAE08 \uC548 \uD0C0\uBA74 \uC774\uAC70 \uB193\uCE58\uB294
    \uAC70\uC57C! \uC5B4\uB5A1\uD574, \uBE68\uB9AC \uC815\uD574\uC918!"
  - "\uC62C\uB77C\uAC00! \uC62C\uB77C\uAC04\uB2E4\uACE0! \uADFC\uB370 \uC774\uAC70
    \uAF2D\uC9C0\uBA74 \uC5B4\uCA4C\uC9C0... \uC624\uBE60\uAC00 \uC815\uD574\uC918!"
  - "\uD638\uAC00\uCC3D\uC774 \uB2E4 \uB179\uC544\uBC84\uB838\uC5B4...! \uC624\uBE60,
    \uC774\uAC74 \uC9C4\uC9DC\uC57C? \uC544\uB2C8\uBA74 \uD568\uC815\uC774\uC57C?!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uACFC\uC5F4\uB41C \uC57D\uC815\uC774 \uC2DD\uC744 \uB54C\uAE4C\uC9C0
