  TemplateID: Community_Pump_Medium_USSession
  ThemeTag: "[Community_Pump_Medium_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uC0C1\uB2F9\uD55C \uB300\uD615 \uCEE4\uBBA4\uB2C8\uD2F0(\uB808\uB527
    \uB4F1)\uC758 \uC870\uC9C1\uC801\uC778 \uD38C\uD551/\uB364\uD551 \uC120\uB3D9\uC73C\uB85C
    \uC778\uD55C \uAC15\uB825\uD55C \uC0C1\uC2B9(\uD3EC\uBAA8/\uBE45\uB871) \uBE54
    \uD3ED\uBC1C \uC0C1\uD669"
  FallbackTitle: "[\uC18D\uBCF4] \uB300\uD615 \uCEE4\uBBA4\uB2C8\uD2F0 \uC870\uC9C1\uC801
    \uC120\uB3D9, \uB9E4\uC218\uC138 \uD3ED\uBC1C"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uB300\uD615 \uCEE4\uBBA4\uB2C8\uD2F0\uAC00 \uD2B9\uC815 \uC2DC\uAC01\uC744 \uC9C0\uBAA9\uD574
    \uC870\uC9C1\uC801\uC778 \uB9E4\uB9E4\uB97C \uC120\uB3D9\uD558\uACE0 \uC788\uB2E4.
    \uB9E4\uC218 \uC8FC\uBB38\uC774 \uD638\uAC00\uCC3D\uC744 \uC4F8\uC5B4\uC62C\uB9AC\uBA70
    \uD3EC\uBAA8 \uC2EC\uB9AC\uAC00 \uBE60\uB974\uAC8C \uBC88\uC9C0\uB294 \uC911\uC774\uB2E4.
    \uB808\uBC84\uB9AC\uC9C0\uB97C \uC954 \uACC4\uC88C\uB77C\uBA74 \uC9C0\uAE08 \uD310\uB2E8\uC774
    \uD558\uB8E8 \uC190\uC775\uC744 \uAC00\uB978\uB2E4."
  FallbackMonologues:
  - "\uC2EC\uC7A5\uC774 \uD130\uC9C8 \uAC83 \uAC19\uC544! \uC9C0\uAE08 \uB4E4\uC5B4\uAC00\uBA74
    \uBA39\uB294 \uAC70 \uB9DE\uC9C0? \uB9DE\uB2E4\uACE0 \uD574\uC918 \uC624\uBE60!"
  - "\uAC70\uB798\uB7C9\uC774 \uBBF8\uCCE4\uC5B4... \uC774\uB7F0 \uAC74 \uCC98\uC74C
    \uBD10. \uC624\uBE60, \uC694\uBBF8 \uBB34\uC11C\uC6CC. \uC5B4\uB5A1\uD560 \uAC70\uC57C?"
  - "\uC624\uBE60...! \uC9C0\uAE08 \uC548 \uD0C0\uBA74 \uC774\uAC70 \uB193\uCE58\uB294
    \uAC70\uC57C! \uC5B4\uB5A1\uD574, \uBE68\uB9AC \uC815\uD574\uC918!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uC120\uB3D9\uC5D0 \uB9D0\uB824\uB4E4\uC9C0 \uC54A\uACE0 \uC815\uB9AC\uD55C\uB2E4"
    OptionDescription: "\uC870\uC9C1\uC801 \uC120\uB3D9\uC5D0 \uBB3C\uB9B4 \uC704\uD5D8\uC744
      \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    RequiredItemId: 
