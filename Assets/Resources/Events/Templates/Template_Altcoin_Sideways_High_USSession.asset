  TemplateID: Altcoin_Sideways_High_USSession
  ThemeTag: "[Altcoin_Sideways_High_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uADF9\uB3C4\uC758 \uCE58\uBA85\uC801\uC778 \uC8FC\uC694
    \uC54C\uD2B8\uCF54\uC778 \uB124\uD2B8\uC6CC\uD06C \uB9C8\uBE44 \uBC0F \uB514\uD398\uAE45
    \uC0AC\uD0DC\uB85C \uC778\uD55C \uADF9\uB3C4\uC758 \uB208\uCE58\uC2F8\uC6C0\uACFC
    \uC228\uB9C9\uD788\uB294 \uD6A1\uBCF4\uC7A5 \uC0C1\uD669"
  FallbackTitle: "[\uAE34\uAE09] \uC8FC\uC694 \uC54C\uD2B8\uCF54\uC778 \uB124\uD2B8\uC6CC\uD06C
    \uB9C8\uBE44, \uAC70\uB798\uB7C9 \uC2E4\uC885 \uB208\uCE58\uC2F8\uC6C0"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uC8FC\uC694 \uC54C\uD2B8\uCF54\uC778 \uB124\uD2B8\uC6CC\uD06C\uAC00 \uBA48\uCD94\uACE0
    \uC2A4\uD14C\uC774\uBE14\uCF54\uC778 \uB514\uD398\uAE45 \uC6B0\uB824\uAE4C\uC9C0
    \uACB9\uCCE4\uB2E4. \uC591\uCE21 \uBAA8\uB450 \uBC29\uD5A5\uC744 \uD655\uC2E0\uD558\uC9C0
    \uBABB\uD574 \uAC70\uB798\uB7C9\uC774 \uB9C8\uB974\uACE0 \uBCC0\uB3D9\uC131\uB9CC
    \uC751\uCD95\uB418\uACE0 \uC788\uB2E4. \uC9C0\uAE08\uC758 \uD55C \uBC88\uC758
    \uC120\uD0DD\uC774 \uACC4\uC88C\uB97C \uD1B5\uC9F8\uB85C \uB0A0\uB9B4 \uC218\uB3C4,
    \uC0B4\uB9B4 \uC218\uB3C4 \uC788\uB2E4."
  FallbackMonologues:
  - "\uBCC0\uB3D9\uC131\uC774 \uC751\uCD95\uB418\uACE0 \uC788\uC5B4... \uD130\uC9C0\uBA74
    \uD55C\uCABD\uC73C\uB85C \uD06C\uAC8C \uAC08 \uAC70\uC57C. \uC900\uBE44\uD574\uC57C
    \uD574!"
  - "\uC9C0\uB8E8\uD558\uB2E4\uACE0 \uBC29\uC2EC\uD558\uBA74 \uC548 \uB3FC \uC624\uBE60.
    \uC774\uB7F0 \uC7A5\uC774 \uC81C\uC77C \uBB34\uC12D\uAC8C \uD130\uC9C4\uB2E4\uACE0."
  - "\uC624\uBE60... \uC544\uBB34\uB3C4 \uC548 \uC6C0\uC9C1\uC5EC. \uC774\uAC70 \uD130\uC9C0\uAE30
    \uC9C1\uC804\uC774\uB77C\uB294 \uB73B\uC774\uC57C..."
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uC54C\uD2B8\uB97C \uC815\uB9AC\uD558\uACE0 \uC0AC\uD0DC\uB97C
      \uC9C0\uCF1C\uBCF8\uB2E4"
    OptionDescription: "\uCCB4\uC778\uC774 \uBA48\uCD98 \uC54C\uD2B8\uC758 \uC704\uD5D8\uC744
