  TemplateID: Influencer_Crash_High_USSession
  ThemeTag: "[Influencer_Crash_High_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uADF9\uB3C4\uC758 \uCE58\uBA85\uC801\uC778 \uC720\uBA85
    \uC778\uD50C\uB8E8\uC5B8\uC11C\uC758 \uAE30\uC2B5\uC801\uC778 SNS \uBC1C\uC5B8\uC73C\uB85C
    \uC778\uD55C \uACF5\uD3EC\uC758 \uC5F0\uC1C4 \uD558\uB77D(\uD328\uB2C9\uC140/\uBE45\uC20F)
    \uBE54 \uD3ED\uB77D \uC0C1\uD669"
  FallbackTitle: "[\uAE34\uAE09] \uC720\uBA85 \uC778\uD50C\uB8E8\uC5B8\uC11C \uAE30\uC2B5
    \uBC1C\uC5B8, \uD328\uB2C9\uC140 \uC5F0\uC1C4 \uD558\uB77D"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uC218\uBC31\uB9CC \uD314\uB85C\uC6CC\uB97C \uAC00\uC9C4 \uC778\uD50C\uB8E8\uC5B8\uC11C\uAC00
    \uC608\uACE0 \uC5C6\uC774 \uC2DC\uC7A5\uC744 \uACA8\uB0E5\uD55C \uAE00\uC744
    \uC62C\uB838\uB2E4. \uC190\uC808 \uBB3C\uB7C9\uC774 \uC190\uC808\uC744 \uBD80\uB974\uBA70
    \uD558\uBC29\uC73C\uB85C \uACC4\uB2E8\uC2DD \uAE09\uB77D\uC774 \uC774\uC5B4\uC9C0\uACE0
    \uC788\uB2E4. \uC9C0\uAE08\uC758 \uD55C \uBC88\uC758 \uC120\uD0DD\uC774 \uACC4\uC88C\uB97C
    \uD1B5\uC9F8\uB85C \uB0A0\uB9B4 \uC218\uB3C4, \uC0B4\uB9B4 \uC218\uB3C4 \uC788\uB2E4."
  FallbackMonologues:
  - "\uC624\uBE60...! \uC774\uAC70 \uADF8\uB0E5 \uD758\uB7EC\uB0B4\uB9AC\uACE0 \uC788\uC5B4!
    \uC9C0\uAE08 \uC548 \uB358\uC9C0\uBA74 \uB2E4 \uC8FD\uC5B4!"
  - "\uC548 \uB3FC... \uC774 \uC18D\uB3C4\uBA74 \uCCAD\uC0B0\uC774\uC57C. \uC624\uBE60,
    \uC81C\uBC1C \uBE68\uB9AC \uC815\uD574\uC918...!"
  - "\uBC11\uC774 \uC548 \uBCF4\uC5EC... \uBC1B\uCCD0\uC904 \uB9E4\uC218\uBCBD\uC774
    \uD558\uB098\uB3C4 \uC5C6\uC5B4! \uC5B4\uB5BB\uAC8C \uD574\uC57C \uB3FC?!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uB9D0\uC5D0 \uD718\uB458\uB9AC\uC9C0 \uC54A\uACE0 \uD3EC\uC9C0\uC158\uC744
