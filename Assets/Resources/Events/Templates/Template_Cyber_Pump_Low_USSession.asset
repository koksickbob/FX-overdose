  m_Script: {fileID: 11500000, guid: 39e0ce48fc36e6148bcb9df931e5b118, type: 3}
  m_Name: Template_Cyber_Pump_Low_USSession
  m_EditorClassIdentifier: Assembly-CSharp::FXOverdose.Events.EventLogicTemplateSO
  TemplateID: Cyber_Pump_Low_USSession
  ThemeTag: "[Cyber_Pump_Low_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300 \uAC1C\uC7A5
    \uC9C1\uD6C4, \uBE44\uAD50\uC801 \uACBD\uBBF8\uD55C \uD574\uD0B9, \uB525\uC6F9
    \uCC0C\uB77C\uC2DC \uB610\uB294 AI \uC2DC\uC2A4\uD15C \uC624\uB958\uB85C \uC778\uD55C
    \uAC15\uB825\uD55C \uC0C1\uC2B9(\uD3EC\uBAA8/\uBE45\uB871) \uBE54 \uD3ED\uBC1C
    \uC0C1\uD669"
  FallbackTitle: "[\uC2DC\uD669] \uD574\uD0B9 \uC815\uD669\uACFC \uB525\uC6F9 \uCC0C\uB77C\uC2DC
    \uD655\uC0B0, \uB9E4\uC218\uC138 \uD3ED\uBC1C"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uCD9C\uCC98 \uBD88\uBA85\uC758 \uD574\uD0B9 \uC815\uD669\uC774 \uB525\uC6F9\uC5D0\uC11C
    \uB3CC\uAE30 \uC2DC\uC791\uD588\uACE0 \uAC70\uB798\uC18C\uB294 \uC544\uC9C1 \uD568\uAD6C\uD558\uACE0
    \uC788\uB2E4. \uB9E4\uC218 \uC8FC\uBB38\uC774 \uD638\uAC00\uCC3D\uC744 \uC4F8\uC5B4\uC62C\uB9AC\uBA70
    \uD3EC\uBAA8 \uC2EC\uB9AC\uAC00 \uBE60\uB974\uAC8C \uBC88\uC9C0\uB294 \uC911\uC774\uB2E4.
    \uB2F9\uC7A5 \uACC4\uC88C\uB97C \uD754\uB4E4 \uC815\uB3C4\uB294 \uC544\uB2C8\uC9C0\uB9CC
    \uBC29\uD5A5\uC740 \uC815\uD574\uC57C \uD55C\uB2E4."
  FallbackMonologues:
  - "\uD638\uAC00\uCC3D\uC774 \uB2E4 \uB179\uC544\uBC84\uB838\uC5B4...! \uC624\uBE60,
    \uC774\uAC74 \uC9C4\uC9DC\uC57C? \uC544\uB2C8\uBA74 \uD568\uC815\uC774\uC57C?!"
  - "\uC2EC\uC7A5\uC774 \uD130\uC9C8 \uAC83 \uAC19\uC544! \uC9C0\uAE08 \uB4E4\uC5B4\uAC00\uBA74
    \uBA39\uB294 \uAC70 \uB9DE\uC9C0? \uB9DE\uB2E4\uACE0 \uD574\uC918 \uC624\uBE60!"
  - "\uAC70\uB798\uB7C9\uC774 \uBBF8\uCCE4\uC5B4... \uC774\uB7F0 \uAC74 \uCC98\uC74C
    \uBD10. \uC624\uBE60, \uC694\uBBF8 \uBB34\uC11C\uC6CC. \uC5B4\uB5A1\uD560 \uAC70\uC57C?"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uC9C4\uC704 \uD655\uC778\uAE4C\uC9C0 \uC9C0\uAC11\uC73C\uB85C
      \uB300\uD53C\uD55C\uB2E4"
    OptionDescription: "\uD574\uD0B9 \uC9C4\uC704\uAC00 \uBD88\uD22C\uBA85\uD55C
      \uAD6C\uAC04\uC744 \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC
      \uCCB4\uB825\uC744 \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    RequiredItemId: 
    RequiredItemCount: 0
    OverrideSignalProbTrue: 0
    OverrideBeamPercent: 2.7079184
    OverrideDurationSeconds: 10
    MentalChangeAmount: 9
    HealthChangeAmount: 6
    MentalPenaltyOnFail: 0
    HealthPenaltyOnFail: 0
