  TemplateID: Exchange_Crash_Low_USSession
  ThemeTag: "[Exchange_Crash_Low_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uBE44\uAD50\uC801 \uACBD\uBBF8\uD55C \uAE00\uB85C\uBC8C
    \uB300\uD615 \uAC70\uB798\uC18C\uC758 \uBCF4\uC548/\uBC45\uD06C\uB7F0 \uC774\uC288\uB85C
    \uC778\uD55C \uACF5\uD3EC\uC758 \uC5F0\uC1C4 \uD558\uB77D(\uD328\uB2C9\uC140/\uBE45\uC20F)
    \uBE54 \uD3ED\uB77D \uC0C1\uD669"
  FallbackTitle: "[\uC2DC\uD669] \uB300\uD615 \uAC70\uB798\uC18C \uCD9C\uAE08 \uC9C0\uC5F0\xB7\uBCF4\uC548
    \uACBD\uBCF4, \uD328\uB2C9\uC140 \uC5F0\uC1C4 \uD558\uB77D"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uAE00\uB85C\uBC8C \uB300\uD615 \uAC70\uB798\uC18C\uAC00 \uC810\uAC80\uC744 \uC774\uC720\uB85C
    \uCD9C\uAE08\uC744 \uC9C0\uC5F0\uC2DC\uD0A4\uC790 \uBC45\uD06C\uB7F0 \uC6B0\uB824\uAC00
    \uBC88\uC9C0\uACE0 \uC788\uB2E4. \uC190\uC808 \uBB3C\uB7C9\uC774 \uC190\uC808\uC744
    \uBD80\uB974\uBA70 \uD558\uBC29\uC73C\uB85C \uACC4\uB2E8\uC2DD \uAE09\uB77D\uC774
    \uC774\uC5B4\uC9C0\uACE0 \uC788\uB2E4. \uB2F9\uC7A5 \uACC4\uC88C\uB97C \uD754\uB4E4
    \uC815\uB3C4\uB294 \uC544\uB2C8\uC9C0\uB9CC \uBC29\uD5A5\uC740 \uC815\uD574\uC57C
    \uD55C\uB2E4."
  FallbackMonologues:
  - "\uC694\uBBF8 \uACC4\uC0B0\uC774 \uB2E4 \uD2C0\uB838\uC5B4... \uC624\uBE60\uAC00
    \uB300\uC2E0 \uC815\uD574\uC918. \uC704\uC57C, \uC544\uB798\uC57C?!"
  - "\uC190\uC808 \uBB3C\uB7C9\uC774 \uC190\uC808\uC744 \uBD80\uB974\uACE0 \uC788\uC5B4...!
    \uC5EC\uAE30\uC11C \uBC84\uD2F0\uB294 \uAC8C \uB9DE\uC544, \uC624\uBE60?"
  - "\uC624\uBE60...! \uC774\uAC70 \uADF8\uB0E5 \uD758\uB7EC\uB0B4\uB9AC\uACE0 \uC788\uC5B4!
    \uC9C0\uAE08 \uC548 \uB358\uC9C0\uBA74 \uB2E4 \uC8FD\uC5B4!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uAC70\uB798\uC18C\uC5D0\uC11C \uC790\uAE08\uC744 \uBE7C\uACE0
      \uAD00\uB9DD\uD55C\uB2E4"
    OptionDescription: "\uCD9C\uAE08\uC774 \uB9C9\uD790 \uC218 \uC788\uB294 \uC704\uD5D8\uC744
