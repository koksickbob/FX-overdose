  TemplateID: Technical_Whipsaw_High_AsiaSession
  ThemeTag: "[Technical_Whipsaw_High_AsiaSession] \uC544\uC2DC\uC544\uC7A5 \uC2DC\uAC04\uB300,
    \uADF9\uB3C4\uC758 \uCE58\uBA85\uC801\uC778 \uC911\uC694\uD55C \uCC28\uD2B8 \uAE30\uC220\uC801
    \uC9C0\uC9C0/\uC800\uD56D\uC120 \uBD95\uAD34 \uBC0F \uB3CC\uD30C\uB85C \uC778\uD55C
    \uC704\uC544\uB798\uB85C \uD06C\uAC8C \uC694\uB3D9\uCE58\uBA70 \uCCAD\uC0B0 \uB9F5\uC744
    \uD130\uB294 \uD729\uC18C \uC7A5\uC138 \uC0C1\uD669"
  FallbackTitle: "[\uAE34\uAE09] \uD575\uC2EC \uC9C0\uC9C0\uC120\xB7\uC800\uD56D\uC120
    \uC774\uD0C8, \uC591\uBC29\uD5A5 \uCCAD\uC0B0 \uD3ED\uD0C4"
  FallbackDescription: "\uC544\uC2DC\uC544\uC7A5\uC774 \uC5F4\uB9B0 \uC9C1\uD6C4
    \uC218\uAC1C\uC6D4\uAC04 \uC9C0\uCF1C\uC9C0\uB358 \uAE30\uC220\uC801 \uBD84\uAE30\uC810\uC774
    \uB300\uB7C9 \uAC70\uB798\uB97C \uB3D9\uBC18\uD558\uBA70 \uBB34\uB108\uC84C\uB2E4.
    \uC704\uC544\uB798\uB85C \uD06C\uAC8C \uD754\uB4E4\uBA70 \uB871\uACFC \uC20F\uC758
    \uCCAD\uC0B0 \uB9F5\uC744 \uBC88\uAC08\uC544 \uD138\uC5B4\uB0B4\uACE0 \uC788\uB2E4.
    \uC9C0\uAE08\uC758 \uD55C \uBC88\uC758 \uC120\uD0DD\uC774 \uACC4\uC88C\uB97C
    \uD1B5\uC9F8\uB85C \uB0A0\uB9B4 \uC218\uB3C4, \uC0B4\uB9B4 \uC218\uB3C4 \uC788\uB2E4."
  FallbackMonologues:
  - "\uC624\uBE60...! \uC704\uC544\uB798\uB85C \uB2E4 \uD138\uC5B4\uB0B4\uACE0 \uC788\uC5B4!
    \uC774\uAC74 \uADF8\uB0E5 \uCCAD\uC0B0 \uC0AC\uB0E5\uC774\uC57C!"
  - "\uB871\uB3C4 \uC20F\uB3C4 \uB2E4 \uC8FD\uC5C8\uC5B4... \uC774\uB7F0 \uC7A5\uC5D0\uC11C
    \uBB58 \uC5B4\uB5BB\uAC8C \uD558\uB77C\uB294 \uAC70\uC57C?!"
  - "\uC18D\uC9C0 \uB9C8 \uC624\uBE60! \uC774\uAC70 \uC704\uB85C \uD55C \uBC88 \uBCF4\uC5EC\uC8FC\uACE0
    \uBC11\uC73C\uB85C \uAF42\uC744 \uAC70\uC57C!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uCD94\uC138\uAC00 \uB2E4\uC2DC \uC7A1\uD790 \uB54C\uAE4C\uC9C0
      \uC26C\uC5B4\uAC04\uB2E4"
    OptionDescription: "\uCD94\uC138\uAC00 \uB4A4\uC9D1\uD788\uB294 \uD63C\uC804\uC744
      \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
