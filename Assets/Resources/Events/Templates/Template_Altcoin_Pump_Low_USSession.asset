  TemplateID: Altcoin_Pump_Low_USSession
  ThemeTag: "[Altcoin_Pump_Low_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300 \uAC1C\uC7A5
    \uC9C1\uD6C4, \uBE44\uAD50\uC801 \uACBD\uBBF8\uD55C \uC8FC\uC694 \uC54C\uD2B8\uCF54\uC778
    \uB124\uD2B8\uC6CC\uD06C \uB9C8\uBE44 \uBC0F \uB514\uD398\uAE45 \uC0AC\uD0DC\uB85C
    \uC778\uD55C \uAC15\uB825\uD55C \uC0C1\uC2B9(\uD3EC\uBAA8/\uBE45\uB871) \uBE54
    \uD3ED\uBC1C \uC0C1\uD669"
  FallbackTitle: "[\uC2DC\uD669] \uC8FC\uC694 \uC54C\uD2B8\uCF54\uC778 \uB124\uD2B8\uC6CC\uD06C
    \uB9C8\uBE44, \uB9E4\uC218\uC138 \uD3ED\uBC1C"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uC8FC\uC694 \uC54C\uD2B8\uCF54\uC778 \uB124\uD2B8\uC6CC\uD06C\uAC00 \uBA48\uCD94\uACE0
    \uC2A4\uD14C\uC774\uBE14\uCF54\uC778 \uB514\uD398\uAE45 \uC6B0\uB824\uAE4C\uC9C0
    \uACB9\uCCE4\uB2E4. \uB9E4\uC218 \uC8FC\uBB38\uC774 \uD638\uAC00\uCC3D\uC744
    \uC4F8\uC5B4\uC62C\uB9AC\uBA70 \uD3EC\uBAA8 \uC2EC\uB9AC\uAC00 \uBE60\uB974\uAC8C
    \uBC88\uC9C0\uB294 \uC911\uC774\uB2E4. \uB2F9\uC7A5 \uACC4\uC88C\uB97C \uD754\uB4E4
    \uC815\uB3C4\uB294 \uC544\uB2C8\uC9C0\uB9CC \uBC29\uD5A5\uC740 \uC815\uD574\uC57C
    \uD55C\uB2E4."
  FallbackMonologues:
  - "\uC2EC\uC7A5\uC774 \uD130\uC9C8 \uAC83 \uAC19\uC544! \uC9C0\uAE08 \uB4E4\uC5B4\uAC00\uBA74
    \uBA39\uB294 \uAC70 \uB9DE\uC9C0? \uB9DE\uB2E4\uACE0 \uD574\uC918 \uC624\uBE60!"
  - "\uAC70\uB798\uB7C9\uC774 \uBBF8\uCCE4\uC5B4... \uC774\uB7F0 \uAC74 \uCC98\uC74C
    \uBD10. \uC624\uBE60, \uC694\uBBF8 \uBB34\uC11C\uC6CC. \uC5B4\uB5A1\uD560 \uAC70\uC57C?"
  - "\uC624\uBE60...! \uC9C0\uAE08 \uC548 \uD0C0\uBA74 \uC774\uAC70 \uB193\uCE58\uB294
    \uAC70\uC57C! \uC5B4\uB5A1\uD574, \uBE68\uB9AC \uC815\uD574\uC918!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uC54C\uD2B8\uB97C \uC815\uB9AC\uD558\uACE0 \uC0AC\uD0DC\uB97C
      \uC9C0\uCF1C\uBCF8\uB2E4"
    OptionDescription: "\uCCB4\uC778\uC774 \uBA48\uCD98 \uC54C\uD2B8\uC758 \uC704\uD5D8\uC744
      \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    RequiredItemId: 
