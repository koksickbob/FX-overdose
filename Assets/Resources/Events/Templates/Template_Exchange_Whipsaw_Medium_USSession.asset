  TemplateID: Exchange_Whipsaw_Medium_USSession
  ThemeTag: "[Exchange_Whipsaw_Medium_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uC0C1\uB2F9\uD55C \uAE00\uB85C\uBC8C \uB300\uD615
    \uAC70\uB798\uC18C\uC758 \uBCF4\uC548/\uBC45\uD06C\uB7F0 \uC774\uC288\uB85C \uC778\uD55C
    \uC704\uC544\uB798\uB85C \uD06C\uAC8C \uC694\uB3D9\uCE58\uBA70 \uCCAD\uC0B0 \uB9F5\uC744
    \uD130\uB294 \uD729\uC18C \uC7A5\uC138 \uC0C1\uD669"
  FallbackTitle: "[\uC18D\uBCF4] \uB300\uD615 \uAC70\uB798\uC18C \uCD9C\uAE08 \uC9C0\uC5F0\xB7\uBCF4\uC548
    \uACBD\uBCF4, \uC591\uBC29\uD5A5 \uCCAD\uC0B0 \uD3ED\uD0C4"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uAE00\uB85C\uBC8C \uB300\uD615 \uAC70\uB798\uC18C\uAC00 \uC810\uAC80\uC744 \uC774\uC720\uB85C
    \uCD9C\uAE08\uC744 \uC9C0\uC5F0\uC2DC\uD0A4\uC790 \uBC45\uD06C\uB7F0 \uC6B0\uB824\uAC00
    \uBC88\uC9C0\uACE0 \uC788\uB2E4. \uC704\uC544\uB798\uB85C \uD06C\uAC8C \uD754\uB4E4\uBA70
    \uB871\uACFC \uC20F\uC758 \uCCAD\uC0B0 \uB9F5\uC744 \uBC88\uAC08\uC544 \uD138\uC5B4\uB0B4\uACE0
    \uC788\uB2E4. \uB808\uBC84\uB9AC\uC9C0\uB97C \uC954 \uACC4\uC88C\uB77C\uBA74
    \uC9C0\uAE08 \uD310\uB2E8\uC774 \uD558\uB8E8 \uC190\uC775\uC744 \uAC00\uB978\uB2E4."
  FallbackMonologues:
  - "\uB871\uB3C4 \uC20F\uB3C4 \uB2E4 \uC8FD\uC5C8\uC5B4... \uC774\uB7F0 \uC7A5\uC5D0\uC11C
    \uBB58 \uC5B4\uB5BB\uAC8C \uD558\uB77C\uB294 \uAC70\uC57C?!"
  - "\uC18D\uC9C0 \uB9C8 \uC624\uBE60! \uC774\uAC70 \uC704\uB85C \uD55C \uBC88 \uBCF4\uC5EC\uC8FC\uACE0
    \uBC11\uC73C\uB85C \uAF42\uC744 \uAC70\uC57C!"
  - "\uC2EC\uC9C0\uAC00 \uC774\uB807\uAC8C \uAE38\uB2E4\uACE0?! \uC624\uBE60, \uC5EC\uAE30
    \uB4E4\uC5B4\uAC00\uBA74 \uC9C4\uC9DC \uC704\uD5D8\uD574...!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uAC70\uB798\uC18C\uC5D0\uC11C \uC790\uAE08\uC744 \uBE7C\uACE0
      \uAD00\uB9DD\uD55C\uB2E4"
    OptionDescription: "\uCD9C\uAE08\uC774 \uB9C9\uD790 \uC218 \uC788\uB294 \uC704\uD5D8\uC744
