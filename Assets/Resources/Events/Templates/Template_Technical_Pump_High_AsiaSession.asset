  m_Name: Template_Technical_Pump_High_AsiaSession
  m_EditorClassIdentifier: Assembly-CSharp::FXOverdose.Events.EventLogicTemplateSO
  TemplateID: Technical_Pump_High_AsiaSession
  ThemeTag: "[Technical_Pump_High_AsiaSession] \uC544\uC2DC\uC544\uC7A5 \uC2DC\uAC04\uB300,
    \uADF9\uB3C4\uC758 \uCE58\uBA85\uC801\uC778 \uC911\uC694\uD55C \uCC28\uD2B8 \uAE30\uC220\uC801
    \uC9C0\uC9C0/\uC800\uD56D\uC120 \uBD95\uAD34 \uBC0F \uB3CC\uD30C\uB85C \uC778\uD55C
    \uAC15\uB825\uD55C \uC0C1\uC2B9(\uD3EC\uBAA8/\uBE45\uB871) \uBE54 \uD3ED\uBC1C
    \uC0C1\uD669"
  FallbackTitle: "[\uAE34\uAE09] \uD575\uC2EC \uC9C0\uC9C0\uC120\xB7\uC800\uD56D\uC120
    \uC774\uD0C8, \uB9E4\uC218\uC138 \uD3ED\uBC1C"
  FallbackDescription: "\uC544\uC2DC\uC544\uC7A5\uC774 \uC5F4\uB9B0 \uC9C1\uD6C4
    \uC218\uAC1C\uC6D4\uAC04 \uC9C0\uCF1C\uC9C0\uB358 \uAE30\uC220\uC801 \uBD84\uAE30\uC810\uC774
    \uB300\uB7C9 \uAC70\uB798\uB97C \uB3D9\uBC18\uD558\uBA70 \uBB34\uB108\uC84C\uB2E4.
    \uB9E4\uC218 \uC8FC\uBB38\uC774 \uD638\uAC00\uCC3D\uC744 \uC4F8\uC5B4\uC62C\uB9AC\uBA70
    \uD3EC\uBAA8 \uC2EC\uB9AC\uAC00 \uBE60\uB974\uAC8C \uBC88\uC9C0\uB294 \uC911\uC774\uB2E4.
    \uC9C0\uAE08\uC758 \uD55C \uBC88\uC758 \uC120\uD0DD\uC774 \uACC4\uC88C\uB97C
    \uD1B5\uC9F8\uB85C \uB0A0\uB9B4 \uC218\uB3C4, \uC0B4\uB9B4 \uC218\uB3C4 \uC788\uB2E4."
  FallbackMonologues:
  - "\uD638\uAC00\uCC3D\uC774 \uB2E4 \uB179\uC544\uBC84\uB838\uC5B4...! \uC624\uBE60,
    \uC774\uAC74 \uC9C4\uC9DC\uC57C? \uC544\uB2C8\uBA74 \uD568\uC815\uC774\uC57C?!"
  - "\uC2EC\uC7A5\uC774 \uD130\uC9C8 \uAC83 \uAC19\uC544! \uC9C0\uAE08 \uB4E4\uC5B4\uAC00\uBA74
    \uBA39\uB294 \uAC70 \uB9DE\uC9C0? \uB9DE\uB2E4\uACE0 \uD574\uC918 \uC624\uBE60!"
  - "\uAC70\uB798\uB7C9\uC774 \uBBF8\uCCE4\uC5B4... \uC774\uB7F0 \uAC74 \uCC98\uC74C
    \uBD10. \uC624\uBE60, \uC694\uBBF8 \uBB34\uC11C\uC6CC. \uC5B4\uB5A1\uD560 \uAC70\uC57C?"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uCD94\uC138\uAC00 \uB2E4\uC2DC \uC7A1\uD790 \uB54C\uAE4C\uC9C0
      \uC26C\uC5B4\uAC04\uB2E4"
    OptionDescription: "\uCD94\uC138\uAC00 \uB4A4\uC9D1\uD788\uB294 \uD63C\uC804\uC744
      \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    RequiredItemId: 
    RequiredItemCount: 0
    OverrideSignalProbTrue: 0
    OverrideBeamPercent: 8.030547
    OverrideDurationSeconds: 10
    MentalChangeAmount: 7
    HealthChangeAmount: 12
    MentalPenaltyOnFail: 0
