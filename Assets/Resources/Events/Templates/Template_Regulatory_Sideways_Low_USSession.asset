  TemplateID: Regulatory_Sideways_Low_USSession
  ThemeTag: "[Regulatory_Sideways_Low_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uBE44\uAD50\uC801 \uACBD\uBBF8\uD55C \uAC01\uAD6D
    \uC815\uBD80\uC758 \uD06C\uB9BD\uD1A0 \uADDC\uC81C \uB610\uB294 \uC138\uAE08
    \uBC95\uC548 \uBC1C\uD45C\uB85C \uC778\uD55C \uADF9\uB3C4\uC758 \uB208\uCE58\uC2F8\uC6C0\uACFC
    \uC228\uB9C9\uD788\uB294 \uD6A1\uBCF4\uC7A5 \uC0C1\uD669"
  FallbackTitle: "[\uC2DC\uD669] \uC815\uBD80 \uADDC\uC81C\xB7\uACFC\uC138 \uBC95\uC548
    \uBC1C\uD45C, \uAC70\uB798\uB7C9 \uC2E4\uC885 \uB208\uCE58\uC2F8\uC6C0"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uAC01\uAD6D \uB2F9\uAD6D\uC774 \uB3D9\uC2DC\uB2E4\uBC1C\uC801\uC73C\uB85C \uADDC\uC81C\uC548\uC744
    \uAEBC\uB0B4\uB4E4\uBA74\uC11C \uAE30\uAD00 \uC790\uAE08\uC774 \uAD00\uB9DD\uC73C\uB85C
    \uB3CC\uC544\uC130\uB2E4. \uC591\uCE21 \uBAA8\uB450 \uBC29\uD5A5\uC744 \uD655\uC2E0\uD558\uC9C0
    \uBABB\uD574 \uAC70\uB798\uB7C9\uC774 \uB9C8\uB974\uACE0 \uBCC0\uB3D9\uC131\uB9CC
    \uC751\uCD95\uB418\uACE0 \uC788\uB2E4. \uB2F9\uC7A5 \uACC4\uC88C\uB97C \uD754\uB4E4
    \uC815\uB3C4\uB294 \uC544\uB2C8\uC9C0\uB9CC \uBC29\uD5A5\uC740 \uC815\uD574\uC57C
    \uD55C\uB2E4."
  FallbackMonologues:
  - "\uC591\uCABD \uB2E4 \uB208\uCE58\uB9CC \uBCF4\uACE0 \uC788\uC5B4. \uC624\uBE60,
    \uC6B0\uB9AC\uB294 \uC5B4\uB290 \uCABD\uC5D0 \uC124 \uAC70\uC57C?"
  - "\uBCC0\uB3D9\uC131\uC774 \uC751\uCD95\uB418\uACE0 \uC788\uC5B4... \uD130\uC9C0\uBA74
    \uD55C\uCABD\uC73C\uB85C \uD06C\uAC8C \uAC08 \uAC70\uC57C. \uC900\uBE44\uD574\uC57C
    \uD574!"
  - "\uC9C0\uB8E8\uD558\uB2E4\uACE0 \uBC29\uC2EC\uD558\uBA74 \uC548 \uB3FC \uC624\uBE60.
    \uC774\uB7F0 \uC7A5\uC774 \uC81C\uC77C \uBB34\uC12D\uAC8C \uD130\uC9C4\uB2E4\uACE0."
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uBC95\uC548 \uC724\uACFD\uC774 \uC7A1\uD790 \uB54C\uAE4C\uC9C0
      \uD604\uAE08 \uBCF4\uC720"
    OptionDescription: "\uADDC\uC81C \uC724\uACFD\uC774 \uC548 \uC7A1\uD78C \uAD6C\uAC04\uC744
      \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    RequiredItemId: 
    RequiredItemCount: 0
    OverrideSignalProbTrue: 0
    OverrideBeamPercent: 0
    OverrideDurationSeconds: 10
    MentalChangeAmount: 11
    HealthChangeAmount: 7
    MentalPenaltyOnFail: 0
    HealthPenaltyOnFail: 0
