  m_EditorClassIdentifier: Assembly-CSharp::FXOverdose.Events.EventLogicTemplateSO
  TemplateID: OnChain_Pump_Low_USSession
  ThemeTag: "[OnChain_Pump_Low_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300 \uAC1C\uC7A5
    \uC9C1\uD6C4, \uBE44\uAD50\uC801 \uACBD\uBBF8\uD55C \uC628\uCCB4\uC778 \uB370\uC774\uD130
    \uC0C1\uC758 \uBE44\uC815\uC0C1\uC801\uC778 \uBBF8\uACB0\uC81C\uC57D\uC815(OI)
    \uD3ED\uC99D\uC73C\uB85C \uC778\uD55C \uAC15\uB825\uD55C \uC0C1\uC2B9(\uD3EC\uBAA8/\uBE45\uB871)
    \uBE54 \uD3ED\uBC1C \uC0C1\uD669"
  FallbackTitle: "[\uC2DC\uD669] \uBBF8\uACB0\uC81C\uC57D\uC815 \uBE44\uC815\uC0C1
    \uD3ED\uC99D, \uB9E4\uC218\uC138 \uD3ED\uBC1C"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uC628\uCCB4\uC778 \uC9C0\uD45C\uC0C1 \uBBF8\uACB0\uC81C\uC57D\uC815\uC774 \uB2E8\uAE30\uAC04\uC5D0
    \uBE44\uC815\uC0C1\uC801\uC73C\uB85C \uBD80\uD480\uC5B4 \uC62C\uB790\uB2E4. \uB9E4\uC218
    \uC8FC\uBB38\uC774 \uD638\uAC00\uCC3D\uC744 \uC4F8\uC5B4\uC62C\uB9AC\uBA70 \uD3EC\uBAA8
    \uC2EC\uB9AC\uAC00 \uBE60\uB974\uAC8C \uBC88\uC9C0\uB294 \uC911\uC774\uB2E4.
    \uB2F9\uC7A5 \uACC4\uC88C\uB97C \uD754\uB4E4 \uC815\uB3C4\uB294 \uC544\uB2C8\uC9C0\uB9CC
    \uBC29\uD5A5\uC740 \uC815\uD574\uC57C \uD55C\uB2E4."
  FallbackMonologues:
  - "\uC62C\uB77C\uAC00! \uC62C\uB77C\uAC04\uB2E4\uACE0! \uADFC\uB370 \uC774\uAC70
    \uAF2D\uC9C0\uBA74 \uC5B4\uCA4C\uC9C0... \uC624\uBE60\uAC00 \uC815\uD574\uC918!"
  - "\uD638\uAC00\uCC3D\uC774 \uB2E4 \uB179\uC544\uBC84\uB838\uC5B4...! \uC624\uBE60,
    \uC774\uAC74 \uC9C4\uC9DC\uC57C? \uC544\uB2C8\uBA74 \uD568\uC815\uC774\uC57C?!"
  - "\uC2EC\uC7A5\uC774 \uD130\uC9C8 \uAC83 \uAC19\uC544! \uC9C0\uAE08 \uB4E4\uC5B4\uAC00\uBA74
    \uBA39\uB294 \uAC70 \uB9DE\uC9C0? \uB9DE\uB2E4\uACE0 \uD574\uC918 \uC624\uBE60!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uACFC\uC5F4\uB41C \uC57D\uC815\uC774 \uC2DD\uC744 \uB54C\uAE4C\uC9C0
      \uAE30\uB2E4\uB9B0\uB2E4"
    OptionDescription: "\uCCAD\uC0B0\uC774 \uC5F0\uC1C4\uB420 \uACFC\uC5F4 \uAD6C\uAC04\uC744
      \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
