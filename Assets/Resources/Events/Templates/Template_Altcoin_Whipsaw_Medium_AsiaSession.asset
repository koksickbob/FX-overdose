  ThemeTag: "[Altcoin_Whipsaw_Medium_AsiaSession] \uC544\uC2DC\uC544\uC7A5 \uC2DC\uAC04\uB300,
    \uC0C1\uB2F9\uD55C \uC8FC\uC694 \uC54C\uD2B8\uCF54\uC778 \uB124\uD2B8\uC6CC\uD06C
    \uB9C8\uBE44 \uBC0F \uB514\uD398\uAE45 \uC0AC\uD0DC\uB85C \uC778\uD55C \uC704\uC544\uB798\uB85C
