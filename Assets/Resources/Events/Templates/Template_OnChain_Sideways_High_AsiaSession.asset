  TemplateID: OnChain_Sideways_High_AsiaSession
  ThemeTag: "[OnChain_Sideways_High_AsiaSession] \uC544\uC2DC\uC544\uC7A5 \uC2DC\uAC04\uB300,
    \uADF9\uB3C4\uC758 \uCE58\uBA85\uC801\uC778 \uC628\uCCB4\uC778 \uB370\uC774\uD130
    \uC0C1\uC758 \uBE44\uC815\uC0C1\uC801\uC778 \uBBF8\uACB0\uC81C\uC57D\uC815(OI)
    \uD3ED\uC99D\uC73C\uB85C \uC778\uD55C \uADF9\uB3C4\uC758 \uB208\uCE58\uC2F8\uC6C0\uACFC
    \uC228\uB9C9\uD788\uB294 \uD6A1\uBCF4\uC7A5 \uC0C1\uD669"
  FallbackTitle: "[\uAE34\uAE09] \uBBF8\uACB0\uC81C\uC57D\uC815 \uBE44\uC815\uC0C1
    \uD3ED\uC99D, \uAC70\uB798\uB7C9 \uC2E4\uC885 \uB208\uCE58\uC2F8\uC6C0"
  FallbackDescription: "\uC544\uC2DC\uC544\uC7A5\uC774 \uC5F4\uB9B0 \uC9C1\uD6C4
    \uC628\uCCB4\uC778 \uC9C0\uD45C\uC0C1 \uBBF8\uACB0\uC81C\uC57D\uC815\uC774 \uB2E8\uAE30\uAC04\uC5D0
    \uBE44\uC815\uC0C1\uC801\uC73C\uB85C \uBD80\uD480\uC5B4 \uC62C\uB790\uB2E4. \uC591\uCE21
    \uBAA8\uB450 \uBC29\uD5A5\uC744 \uD655\uC2E0\uD558\uC9C0 \uBABB\uD574 \uAC70\uB798\uB7C9\uC774
    \uB9C8\uB974\uACE0 \uBCC0\uB3D9\uC131\uB9CC \uC751\uCD95\uB418\uACE0 \uC788\uB2E4.
    \uC9C0\uAE08\uC758 \uD55C \uBC88\uC758 \uC120\uD0DD\uC774 \uACC4\uC88C\uB97C
    \uD1B5\uC9F8\uB85C \uB0A0\uB9B4 \uC218\uB3C4, \uC0B4\uB9B4 \uC218\uB3C4 \uC788\uB2E4."
  FallbackMonologues:
  - "\uC9C0\uB8E8\uD558\uB2E4\uACE0 \uBC29\uC2EC\uD558\uBA74 \uC548 \uB3FC \uC624\uBE60.
    \uC774\uB7F0 \uC7A5\uC774 \uC81C\uC77C \uBB34\uC12D\uAC8C \uD130\uC9C4\uB2E4\uACE0."
  - "\uC624\uBE60... \uC544\uBB34\uB3C4 \uC548 \uC6C0\uC9C1\uC5EC. \uC774\uAC70 \uD130\uC9C0\uAE30
    \uC9C1\uC804\uC774\uB77C\uB294 \uB73B\uC774\uC57C..."
  - "\uC228 \uB9C9\uD600... \uAC70\uB798\uB7C9\uC774 \uC644\uC804\uD788 \uB9D0\uB790\uC5B4.
    \uC774\uB7F4 \uB54C\uAC00 \uC81C\uC77C \uBB34\uC11C\uC6B4\uB370."
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uACFC\uC5F4\uB41C \uC57D\uC815\uC774 \uC2DD\uC744 \uB54C\uAE4C\uC9C0
      \uAE30\uB2E4\uB9B0\uB2E4"
    OptionDescription: "\uCCAD\uC0B0\uC774 \uC5F0\uC1C4\uB420 \uACFC\uC5F4 \uAD6C\uAC04\uC744
