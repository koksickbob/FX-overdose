  TemplateID: Cyber_Crash_High_USSession
  ThemeTag: "[Cyber_Crash_High_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300 \uAC1C\uC7A5
    \uC9C1\uD6C4, \uADF9\uB3C4\uC758 \uCE58\uBA85\uC801\uC778 \uD574\uD0B9, \uB525\uC6F9
    \uCC0C\uB77C\uC2DC \uB610\uB294 AI \uC2DC\uC2A4\uD15C \uC624\uB958\uB85C \uC778\uD55C
    \uACF5\uD3EC\uC758 \uC5F0\uC1C4 \uD558\uB77D(\uD328\uB2C9\uC140/\uBE45\uC20F)
    \uBE54 \uD3ED\uB77D \uC0C1\uD669"
  FallbackTitle: "[\uAE34\uAE09] \uD574\uD0B9 \uC815\uD669\uACFC \uB525\uC6F9 \uCC0C\uB77C\uC2DC
    \uD655\uC0B0, \uD328\uB2C9\uC140 \uC5F0\uC1C4 \uD558\uB77D"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uCD9C\uCC98 \uBD88\uBA85\uC758 \uD574\uD0B9 \uC815\uD669\uC774 \uB525\uC6F9\uC5D0\uC11C
    \uB3CC\uAE30 \uC2DC\uC791\uD588\uACE0 \uAC70\uB798\uC18C\uB294 \uC544\uC9C1 \uD568\uAD6C\uD558\uACE0
    \uC788\uB2E4. \uC190\uC808 \uBB3C\uB7C9\uC774 \uC190\uC808\uC744 \uBD80\uB974\uBA70
    \uD558\uBC29\uC73C\uB85C \uACC4\uB2E8\uC2DD \uAE09\uB77D\uC774 \uC774\uC5B4\uC9C0\uACE0
    \uC788\uB2E4. \uC9C0\uAE08\uC758 \uD55C \uBC88\uC758 \uC120\uD0DD\uC774 \uACC4\uC88C\uB97C
    \uD1B5\uC9F8\uB85C \uB0A0\uB9B4 \uC218\uB3C4, \uC0B4\uB9B4 \uC218\uB3C4 \uC788\uB2E4."
  FallbackMonologues:
  - "\uC548 \uB3FC... \uC774 \uC18D\uB3C4\uBA74 \uCCAD\uC0B0\uC774\uC57C. \uC624\uBE60,
    \uC81C\uBC1C \uBE68\uB9AC \uC815\uD574\uC918...!"
  - "\uBC11\uC774 \uC548 \uBCF4\uC5EC... \uBC1B\uCCD0\uC904 \uB9E4\uC218\uBCBD\uC774
    \uD558\uB098\uB3C4 \uC5C6\uC5B4! \uC5B4\uB5BB\uAC8C \uD574\uC57C \uB3FC?!"
  - "\uC694\uBBF8 \uACC4\uC0B0\uC774 \uB2E4 \uD2C0\uB838\uC5B4... \uC624\uBE60\uAC00
    \uB300\uC2E0 \uC815\uD574\uC918. \uC704\uC57C, \uC544\uB798\uC57C?!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uC9C4\uC704 \uD655\uC778\uAE4C\uC9C0 \uC9C0\uAC11\uC73C\uB85C
