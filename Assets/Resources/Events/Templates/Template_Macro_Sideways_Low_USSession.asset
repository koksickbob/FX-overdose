  TemplateID: Macro_Sideways_Low_USSession
  ThemeTag: "[Macro_Sideways_Low_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uBE44\uAD50\uC801 \uACBD\uBBF8\uD55C \uAC70\uC2DC\uACBD\uC81C(\uAE08\uB9AC/\uBB3C\uAC00)
    \uC9C0\uD45C \uBC1C\uD45C\uB85C \uC778\uD55C \uADF9\uB3C4\uC758 \uB208\uCE58\uC2F8\uC6C0\uACFC
    \uC228\uB9C9\uD788\uB294 \uD6A1\uBCF4\uC7A5 \uC0C1\uD669"
  FallbackTitle: "[\uC2DC\uD669] \uC608\uC0C1 \uBC16 \uAE08\uB9AC\xB7\uBB3C\uAC00
    \uC9C0\uD45C \uBC1C\uD45C, \uAC70\uB798\uB7C9 \uC2E4\uC885 \uB208\uCE58\uC2F8\uC6C0"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uBC1C\uD45C\uB41C \uAC70\uC2DC \uC9C0\uD45C\uAC00 \uC2DC\uC7A5 \uCEE8\uC13C\uC11C\uC2A4\uB97C
    \uD06C\uAC8C \uBC97\uC5B4\uB098\uBA74\uC11C \uC704\uD5D8\uC790\uC0B0 \uC804\uBC18\uC5D0
    \uC790\uAE08\uC774 \uC7AC\uBC30\uCE58\uB418\uACE0 \uC788\uB2E4. \uC591\uCE21
    \uBAA8\uB450 \uBC29\uD5A5\uC744 \uD655\uC2E0\uD558\uC9C0 \uBABB\uD574 \uAC70\uB798\uB7C9\uC774
    \uB9C8\uB974\uACE0 \uBCC0\uB3D9\uC131\uB9CC \uC751\uCD95\uB418\uACE0 \uC788\uB2E4.
    \uB2F9\uC7A5 \uACC4\uC88C\uB97C \uD754\uB4E4 \uC815\uB3C4\uB294 \uC544\uB2C8\uC9C0\uB9CC
    \uBC29\uD5A5\uC740 \uC815\uD574\uC57C \uD55C\uB2E4."
  FallbackMonologues:
  - "\uC624\uBE60... \uC544\uBB34\uB3C4 \uC548 \uC6C0\uC9C1\uC5EC. \uC774\uAC70 \uD130\uC9C0\uAE30
    \uC9C1\uC804\uC774\uB77C\uB294 \uB73B\uC774\uC57C..."
  - "\uC228 \uB9C9\uD600... \uAC70\uB798\uB7C9\uC774 \uC644\uC804\uD788 \uB9D0\uB790\uC5B4.
    \uC774\uB7F4 \uB54C\uAC00 \uC81C\uC77C \uBB34\uC11C\uC6B4\uB370."
  - "\uC591\uCABD \uB2E4 \uB208\uCE58\uB9CC \uBCF4\uACE0 \uC788\uC5B4. \uC624\uBE60,
    \uC6B0\uB9AC\uB294 \uC5B4\uB290 \uCABD\uC5D0 \uC124 \uAC70\uC57C?"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uC9C0\uD45C \uD574\uC11D\uC774 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0
      \uBE44\uC6B4\uB2E4"
    OptionDescription: "\uC9C0\uD45C \uD574\uC11D\uC774 \uC5C7\uAC08\uB9AC\uB294
      \uAD6C\uAC04\uC744 \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC
      \uCCB4\uB825\uC744 \uD68C\uBCF5\uD569\uB2C8\uB2E4."
