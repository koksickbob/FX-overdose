  TemplateID: Cyber_Whipsaw_Low_AsiaSession
  ThemeTag: "[Cyber_Whipsaw_Low_AsiaSession] \uC544\uC2DC\uC544\uC7A5 \uC2DC\uAC04\uB300,
    \uBE44\uAD50\uC801 \uACBD\uBBF8\uD55C \uD574\uD0B9, \uB525\uC6F9 \uCC0C\uB77C\uC2DC
    \uB610\uB294 AI \uC2DC\uC2A4\uD15C \uC624\uB958\uB85C \uC778\uD55C \uC704\uC544\uB798\uB85C
    \uD06C\uAC8C \uC694\uB3D9\uCE58\uBA70 \uCCAD\uC0B0 \uB9F5\uC744 \uD130\uB294
    \uD729\uC18C \uC7A5\uC138 \uC0C1\uD669"
  FallbackTitle: "[\uC2DC\uD669] \uD574\uD0B9 \uC815\uD669\uACFC \uB525\uC6F9 \uCC0C\uB77C\uC2DC
    \uD655\uC0B0, \uC591\uBC29\uD5A5 \uCCAD\uC0B0 \uD3ED\uD0C4"
  FallbackDescription: "\uC544\uC2DC\uC544\uC7A5\uC774 \uC5F4\uB9B0 \uC9C1\uD6C4
    \uCD9C\uCC98 \uBD88\uBA85\uC758 \uD574\uD0B9 \uC815\uD669\uC774 \uB525\uC6F9\uC5D0\uC11C
    \uB3CC\uAE30 \uC2DC\uC791\uD588\uACE0 \uAC70\uB798\uC18C\uB294 \uC544\uC9C1 \uD568\uAD6C\uD558\uACE0
    \uC788\uB2E4. \uC704\uC544\uB798\uB85C \uD06C\uAC8C \uD754\uB4E4\uBA70 \uB871\uACFC
    \uC20F\uC758 \uCCAD\uC0B0 \uB9F5\uC744 \uBC88\uAC08\uC544 \uD138\uC5B4\uB0B4\uACE0
    \uC788\uB2E4. \uB2F9\uC7A5 \uACC4\uC88C\uB97C \uD754\uB4E4 \uC815\uB3C4\uB294
    \uC544\uB2C8\uC9C0\uB9CC \uBC29\uD5A5\uC740 \uC815\uD574\uC57C \uD55C\uB2E4."
  FallbackMonologues:
  - "\uC624\uBE60...! \uC704\uC544\uB798\uB85C \uB2E4 \uD138\uC5B4\uB0B4\uACE0 \uC788\uC5B4!
    \uC774\uAC74 \uADF8\uB0E5 \uCCAD\uC0B0 \uC0AC\uB0E5\uC774\uC57C!"
  - "\uB871\uB3C4 \uC20F\uB3C4 \uB2E4 \uC8FD\uC5C8\uC5B4... \uC774\uB7F0 \uC7A5\uC5D0\uC11C
    \uBB58 \uC5B4\uB5BB\uAC8C \uD558\uB77C\uB294 \uAC70\uC57C?!"
  - "\uC18D\uC9C0 \uB9C8 \uC624\uBE60! \uC774\uAC70 \uC704\uB85C \uD55C \uBC88 \uBCF4\uC5EC\uC8FC\uACE0
    \uBC11\uC73C\uB85C \uAF42\uC744 \uAC70\uC57C!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uC9C4\uC704 \uD655\uC778\uAE4C\uC9C0 \uC9C0\uAC11\uC73C\uB85C
      \uB300\uD53C\uD55C\uB2E4"
    OptionDescription: "\uD574\uD0B9 \uC9C4\uC704\uAC00 \uBD88\uD22C\uBA85\uD55C
      \uAD6C\uAC04\uC744 \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC
      \uCCB4\uB825\uC744 \uD68C\uBCF5\uD569\uB2C8\uB2E4."
