  TemplateID: Technical_Sideways_Medium_USSession
  ThemeTag: "[Technical_Sideways_Medium_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uC0C1\uB2F9\uD55C \uC911\uC694\uD55C \uCC28\uD2B8
    \uAE30\uC220\uC801 \uC9C0\uC9C0/\uC800\uD56D\uC120 \uBD95\uAD34 \uBC0F \uB3CC\uD30C\uB85C
    \uC778\uD55C \uADF9\uB3C4\uC758 \uB208\uCE58\uC2F8\uC6C0\uACFC \uC228\uB9C9\uD788\uB294
    \uD6A1\uBCF4\uC7A5 \uC0C1\uD669"
  FallbackTitle: "[\uC18D\uBCF4] \uD575\uC2EC \uC9C0\uC9C0\uC120\xB7\uC800\uD56D\uC120
    \uC774\uD0C8, \uAC70\uB798\uB7C9 \uC2E4\uC885 \uB208\uCE58\uC2F8\uC6C0"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uC218\uAC1C\uC6D4\uAC04 \uC9C0\uCF1C\uC9C0\uB358 \uAE30\uC220\uC801 \uBD84\uAE30\uC810\uC774
    \uB300\uB7C9 \uAC70\uB798\uB97C \uB3D9\uBC18\uD558\uBA70 \uBB34\uB108\uC84C\uB2E4.
    \uC591\uCE21 \uBAA8\uB450 \uBC29\uD5A5\uC744 \uD655\uC2E0\uD558\uC9C0 \uBABB\uD574
    \uAC70\uB798\uB7C9\uC774 \uB9C8\uB974\uACE0 \uBCC0\uB3D9\uC131\uB9CC \uC751\uCD95\uB418\uACE0
    \uC788\uB2E4. \uB808\uBC84\uB9AC\uC9C0\uB97C \uC954 \uACC4\uC88C\uB77C\uBA74
    \uC9C0\uAE08 \uD310\uB2E8\uC774 \uD558\uB8E8 \uC190\uC775\uC744 \uAC00\uB978\uB2E4."
  FallbackMonologues:
  - "\uC591\uCABD \uB2E4 \uB208\uCE58\uB9CC \uBCF4\uACE0 \uC788\uC5B4. \uC624\uBE60,
    \uC6B0\uB9AC\uB294 \uC5B4\uB290 \uCABD\uC5D0 \uC124 \uAC70\uC57C?"
  - "\uBCC0\uB3D9\uC131\uC774 \uC751\uCD95\uB418\uACE0 \uC788\uC5B4... \uD130\uC9C0\uBA74
    \uD55C\uCABD\uC73C\uB85C \uD06C\uAC8C \uAC08 \uAC70\uC57C. \uC900\uBE44\uD574\uC57C
    \uD574!"
  - "\uC9C0\uB8E8\uD558\uB2E4\uACE0 \uBC29\uC2EC\uD558\uBA74 \uC548 \uB3FC \uC624\uBE60.
    \uC774\uB7F0 \uC7A5\uC774 \uC81C\uC77C \uBB34\uC12D\uAC8C \uD130\uC9C4\uB2E4\uACE0."
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uCD94\uC138\uAC00 \uB2E4\uC2DC \uC7A1\uD790 \uB54C\uAE4C\uC9C0
      \uC26C\uC5B4\uAC04\uB2E4"
    OptionDescription: "\uCD94\uC138\uAC00 \uB4A4\uC9D1\uD788\uB294 \uD63C\uC804\uC744
      \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
    RequiredItemId: 
    RequiredItemCount: 0
    OverrideSignalProbTrue: 0
    OverrideBeamPercent: 0
    OverrideDurationSeconds: 10
    MentalChangeAmount: 19
