  TemplateID: Technical_Pump_Low_USSession
  ThemeTag: "[Technical_Pump_Low_USSession] \uBBF8\uAD6D\uC7A5 \uC2DC\uAC04\uB300
    \uAC1C\uC7A5 \uC9C1\uD6C4, \uBE44\uAD50\uC801 \uACBD\uBBF8\uD55C \uC911\uC694\uD55C
    \uCC28\uD2B8 \uAE30\uC220\uC801 \uC9C0\uC9C0/\uC800\uD56D\uC120 \uBD95\uAD34
    \uBC0F \uB3CC\uD30C\uB85C \uC778\uD55C \uAC15\uB825\uD55C \uC0C1\uC2B9(\uD3EC\uBAA8/\uBE45\uB871)
    \uBE54 \uD3ED\uBC1C \uC0C1\uD669"
  FallbackTitle: "[\uC2DC\uD669] \uD575\uC2EC \uC9C0\uC9C0\uC120\xB7\uC800\uD56D\uC120
    \uC774\uD0C8, \uB9E4\uC218\uC138 \uD3ED\uBC1C"
  FallbackDescription: "\uBBF8\uAD6D\uC7A5 \uAC1C\uC7A5\uACFC \uB3D9\uC2DC\uC5D0
    \uC218\uAC1C\uC6D4\uAC04 \uC9C0\uCF1C\uC9C0\uB358 \uAE30\uC220\uC801 \uBD84\uAE30\uC810\uC774
    \uB300\uB7C9 \uAC70\uB798\uB97C \uB3D9\uBC18\uD558\uBA70 \uBB34\uB108\uC84C\uB2E4.
    \uB9E4\uC218 \uC8FC\uBB38\uC774 \uD638\uAC00\uCC3D\uC744 \uC4F8\uC5B4\uC62C\uB9AC\uBA70
    \uD3EC\uBAA8 \uC2EC\uB9AC\uAC00 \uBE60\uB974\uAC8C \uBC88\uC9C0\uB294 \uC911\uC774\uB2E4.
    \uB2F9\uC7A5 \uACC4\uC88C\uB97C \uD754\uB4E4 \uC815\uB3C4\uB294 \uC544\uB2C8\uC9C0\uB9CC
    \uBC29\uD5A5\uC740 \uC815\uD574\uC57C \uD55C\uB2E4."
  FallbackMonologues:
  - "\uAC70\uB798\uB7C9\uC774 \uBBF8\uCCE4\uC5B4... \uC774\uB7F0 \uAC74 \uCC98\uC74C
    \uBD10. \uC624\uBE60, \uC694\uBBF8 \uBB34\uC11C\uC6CC. \uC5B4\uB5A1\uD560 \uAC70\uC57C?"
  - "\uC624\uBE60...! \uC9C0\uAE08 \uC548 \uD0C0\uBA74 \uC774\uAC70 \uB193\uCE58\uB294
    \uAC70\uC57C! \uC5B4\uB5A1\uD574, \uBE68\uB9AC \uC815\uD574\uC918!"
  - "\uC62C\uB77C\uAC00! \uC62C\uB77C\uAC04\uB2E4\uACE0! \uADFC\uB370 \uC774\uAC70
    \uAF2D\uC9C0\uBA74 \uC5B4\uCA4C\uC9C0... \uC624\uBE60\uAC00 \uC815\uD574\uC918!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uCD94\uC138\uAC00 \uB2E4\uC2DC \uC7A1\uD790 \uB54C\uAE4C\uC9C0
      \uC26C\uC5B4\uAC04\uB2E4"
    OptionDescription: "\uCD94\uC138\uAC00 \uB4A4\uC9D1\uD788\uB294 \uD63C\uC804\uC744
      \uD53C\uD574 \uBB3C\uB7EC\uC12D\uB2C8\uB2E4. \uBA58\uD0C8\uACFC \uCCB4\uB825\uC744
      \uD68C\uBCF5\uD569\uB2C8\uB2E4."
