  ThemeTag: "[Regulatory_Whipsaw_Low_AsiaSession] \uC544\uC2DC\uC544\uC7A5 \uC2DC\uAC04\uB300,
    \uBE44\uAD50\uC801 \uACBD\uBBF8\uD55C \uAC01\uAD6D \uC815\uBD80\uC758 \uD06C\uB9BD\uD1A0
    \uADDC\uC81C \uB610\uB294 \uC138\uAE08 \uBC95\uC548 \uBC1C\uD45C\uB85C \uC778\uD55C
    \uC704\uC544\uB798\uB85C \uD06C\uAC8C \uC694\uB3D9\uCE58\uBA70 \uCCAD\uC0B0 \uB9F5\uC744
    \uD130\uB294 \uD729\uC18C \uC7A5\uC138 \uC0C1\uD669"
  FallbackTitle: "[\uC2DC\uD669] \uC815\uBD80 \uADDC\uC81C\xB7\uACFC\uC138 \uBC95\uC548
    \uBC1C\uD45C, \uC591\uBC29\uD5A5 \uCCAD\uC0B0 \uD3ED\uD0C4"
  FallbackDescription: "\uC544\uC2DC\uC544\uC7A5\uC774 \uC5F4\uB9B0 \uC9C1\uD6C4
    \uAC01\uAD6D \uB2F9\uAD6D\uC774 \uB3D9\uC2DC\uB2E4\uBC1C\uC801\uC73C\uB85C \uADDC\uC81C\uC548\uC744
    \uAEBC\uB0B4\uB4E4\uBA74\uC11C \uAE30\uAD00 \uC790\uAE08\uC774 \uAD00\uB9DD\uC73C\uB85C
    \uB3CC\uC544\uC130\uB2E4. \uC704\uC544\uB798\uB85C \uD06C\uAC8C \uD754\uB4E4\uBA70
    \uB871\uACFC \uC20F\uC758 \uCCAD\uC0B0 \uB9F5\uC744 \uBC88\uAC08\uC544 \uD138\uC5B4\uB0B4\uACE0
    \uC788\uB2E4. \uB2F9\uC7A5 \uACC4\uC88C\uB97C \uD754\uB4E4 \uC815\uB3C4\uB294
    \uC544\uB2C8\uC9C0\uB9CC \uBC29\uD5A5\uC740 \uC815\uD574\uC57C \uD55C\uB2E4."
  FallbackMonologues:
  - "\uC624\uBE60...! \uC704\uC544\uB798\uB85C \uB2E4 \uD138\uC5B4\uB0B4\uACE0 \uC788\uC5B4!
    \uC774\uAC74 \uADF8\uB0E5 \uCCAD\uC0B0 \uC0AC\uB0E5\uC774\uC57C!"
  - "\uB871\uB3C4 \uC20F\uB3C4 \uB2E4 \uC8FD\uC5C8\uC5B4... \uC774\uB7F0 \uC7A5\uC5D0\uC11C
    \uBB58 \uC5B4\uB5BB\uAC8C \uD558\uB77C\uB294 \uAC70\uC57C?!"
  - "\uC18D\uC9C0 \uB9C8 \uC624\uBE60! \uC774\uAC70 \uC704\uB85C \uD55C \uBC88 \uBCF4\uC5EC\uC8FC\uACE0
    \uBC11\uC73C\uB85C \uAF42\uC744 \uAC70\uC57C!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uBC95\uC548 \uC724\uACFD\uC774 \uC7A1\uD790 \uB54C\uAE4C\uC9C0
