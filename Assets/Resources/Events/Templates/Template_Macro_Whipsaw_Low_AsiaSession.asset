  ThemeTag: "[Macro_Whipsaw_Low_AsiaSession] \uC544\uC2DC\uC544\uC7A5 \uC2DC\uAC04\uB300,
    \uBE44\uAD50\uC801 \uACBD\uBBF8\uD55C \uAC70\uC2DC\uACBD\uC81C(\uAE08\uB9AC/\uBB3C\uAC00)
    \uC9C0\uD45C \uBC1C\uD45C\uB85C \uC778\uD55C \uC704\uC544\uB798\uB85C \uD06C\uAC8C
    \uC694\uB3D9\uCE58\uBA70 \uCCAD\uC0B0 \uB9F5\uC744 \uD130\uB294 \uD729\uC18C
    \uC7A5\uC138 \uC0C1\uD669"
  FallbackTitle: "[\uC2DC\uD669] \uC608\uC0C1 \uBC16 \uAE08\uB9AC\xB7\uBB3C\uAC00
    \uC9C0\uD45C \uBC1C\uD45C, \uC591\uBC29\uD5A5 \uCCAD\uC0B0 \uD3ED\uD0C4"
  FallbackDescription: "\uC544\uC2DC\uC544\uC7A5\uC774 \uC5F4\uB9B0 \uC9C1\uD6C4
    \uBC1C\uD45C\uB41C \uAC70\uC2DC \uC9C0\uD45C\uAC00 \uC2DC\uC7A5 \uCEE8\uC13C\uC11C\uC2A4\uB97C
    \uD06C\uAC8C \uBC97\uC5B4\uB098\uBA74\uC11C \uC704\uD5D8\uC790\uC0B0 \uC804\uBC18\uC5D0
    \uC790\uAE08\uC774 \uC7AC\uBC30\uCE58\uB418\uACE0 \uC788\uB2E4. \uC704\uC544\uB798\uB85C
    \uD06C\uAC8C \uD754\uB4E4\uBA70 \uB871\uACFC \uC20F\uC758 \uCCAD\uC0B0 \uB9F5\uC744
    \uBC88\uAC08\uC544 \uD138\uC5B4\uB0B4\uACE0 \uC788\uB2E4. \uB2F9\uC7A5 \uACC4\uC88C\uB97C
    \uD754\uB4E4 \uC815\uB3C4\uB294 \uC544\uB2C8\uC9C0\uB9CC \uBC29\uD5A5\uC740 \uC815\uD574\uC57C
    \uD55C\uB2E4."
  FallbackMonologues:
  - "\uC2EC\uC9C0\uAC00 \uC774\uB807\uAC8C \uAE38\uB2E4\uACE0?! \uC624\uBE60, \uC5EC\uAE30
    \uB4E4\uC5B4\uAC00\uBA74 \uC9C4\uC9DC \uC704\uD5D8\uD574...!"
  - "\uC591\uCABD \uB2E4 \uBB3C\uB9AC\uAC8C \uB9CC\uB4DC\uB294 \uC7A5\uC774\uC57C...
    \uC624\uBE60, \uC2E0\uC911\uD558\uAC8C \uC815\uD574\uC918. \uC81C\uBC1C."
  - "\uC624\uBE60...! \uC704\uC544\uB798\uB85C \uB2E4 \uD138\uC5B4\uB0B4\uACE0 \uC788\uC5B4!
    \uC774\uAC74 \uADF8\uB0E5 \uCCAD\uC0B0 \uC0AC\uB0E5\uC774\uC57C!"
  LogicOptions:
  - OptionType: 0
    OptionTitle: "\uC9C0\uD45C \uD574\uC11D\uC774 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0
      \uBE44\uC6B4\uB2E4"
    OptionDescription: "\uC9C0\uD45C \uD574\uC11D\uC774 \uC5C7\uAC08\uB9AC\uB294
