  m_Name: EVENT_07_WHALE_ALERT
  m_EditorClassIdentifier: Assembly-CSharp::FXOverdose.Events.ChoiceEventSO
  EventID: EVENT_07_WHALE_ALERT
  ScenarioTitle: "\uC804\uC124\uC758 \uACE0\uB798 \uC9C0\uAC11\uC5D0\uC11C 10\uB9CC
    \uBE44\uD2B8\uCF54\uC778 '\uBC14\uC774\uB125\uC2A4(Bynex)' \uC785\uAE08 \uC54C\uB9BC"
  ScenarioDescription: "'Whale Alert' \uC54C\uB9BC\uC774 \uC6B8\uB9BD\uB2C8\uB2E4.
    10\uB144 \uB3D9\uC548 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uB358 \uCD08\uCC3D\uAE30
    \uC804\uC124\uC758 \uACE0\uB798 \uC9C0\uAC11\uC5D0\uC11C 10\uB9CC \uBE44\uD2B8\uCF54\uC778(\uC57D
    8\uC870\uC6D0)\uC774 \uAC70\uB798\uC18C\uB85C \uC785\uAE08\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
    \uC5ED\uB300\uAE09 \uB9E4\uB3C4 \uD3ED\uD0C4\uC774 \uB5A8\uC5B4\uC9C8 \uC218
    \uC788\uB2E4\uB294 \uACF5\uD3EC\uAC00 \uB36E\uCE69\uB2C8\uB2E4."
  AIMonologue: "10\uB9CC \uBE44\uD2B8\uCF54\uC778 \uAC70\uB798\uC18C \uC785\uAE08...?!
    \uC774\uAC74 \uB364\uD551(Dumping) \uC900\uBE44\uC57C. \uC800 \uBB3C\uB7C9\uC774
    \uC2DC\uC7A5\uAC00\uB85C \uB358\uC838\uC9C0\uBA74 \uD638\uAC00\uCC3D\uC774 \uADF8\uB0E5
    \uC18C\uBA78\uD55C\uB2E4\uACE0!! \uB3C4\uB9DD\uCCD0\uC57C \uB3FC...!!"
  TriggerCondition: 0
  Options:
  - OptionType: 0
    OptionTitle: "\uC2E4\uC81C \uB9E4\uB3C4 \uBB3C\uB7C9\uC774 \uB098\uC62C \uB54C\uAE4C\uC9C0
      \uC9C4\uC785\uC744 \uC720\uBCF4\uD55C\uB2E4."
    Description: "\uACE0\uB798\uAC00 \uB358\uC9C0\uC9C0 \uC54A\uACE0 \uC7A5\uC678\uAC70\uB798\uB85C
      \uB118\uAE30\uBA70 \uCC28\uD2B8 \uD6A1\uBCF4 \uC720\uC9C0. \uAE34\uC7A5 \uC644\uD654\uB85C
      \uCCB4\uB825 +10."
