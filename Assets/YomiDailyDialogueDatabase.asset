%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 66febdf3335e58d4ab2438e75ba9c919, type: 3}
  m_Name: YomiDailyDialogueDatabase
  m_EditorClassIdentifier: Assembly-CSharp::FXOverdose.AI.Dialogue.YomiDailyDialogueDatabase
  entries:
  - text: "\uC624\uBE60! \uBC25\uC740 \uBA39\uACE0 \uB2E4\uB2C8\uB294 \uAC70\uC57C?
      \uC694\uBBF8\uAC00 \uAD76\uC9C0 \uB9D0\uB77C\uACE0 \uD588\uC9C0!"
    category: 1
  - text: "\uC544\uC9C1 \uC548 \uBA39\uC5C8\uC5B4! \uC624\uBE60\uAC00 \uC640\uC11C
      \uCC28\uB824\uC8FC\uBA74 \uC548 \uB3FC? \uD5E4\uD5E4"
    category: 1
  - text: "\uBC29\uAE08 \uBC30\uB2EC\uC2DC\uCF1C\uC11C \uBA39\uC5C8\uC9C0\uB871!
      \uC624\uBE60\uB3C4 \uC5BC\uB978 \uCC59\uACA8 \uBA39\uC5B4!"
    category: 1
  - text: "\uC73C\uC74C... \uADC0\uCC2E\uC544\uC11C \uB300\uCDA9 \uB54C\uC6E0\uC5B4.
      \uC624\uBE60\uAC00 \uB9DB\uC788\uB294 \uAC70 \uC0AC\uC8FC\uBA74 \uC88B\uACA0\uB2E4..."
    category: 1
  - text: "\uC694\uBBF8\uB294 \uBC30\uBD80\uB974\uAC8C \uC798 \uBA39\uC5C8\uC5B4!
      \uC624\uBE60\uB294 \uBB50 \uBA39\uC5C8\uC5B4? \uB098 \uD63C\uC790 \uB450\uACE0
      \uB9DB\uC788\uB294 \uAC70 \uBA39\uC740 \uAC74 \uC544\uB2C8\uC9C0?!"
    category: 1
  - text: "\uC624\uBE60\uAC00 \uD574\uC8FC\uB294 \uBC25 \uBA39\uACE0 \uC2F6\uC740\uB370...
      \uB098 \uB370\uB9AC\uB7EC \uC624\uBA74 \uC548 \uB3FC?"
    category: 1
  - text: "\uC694\uBBF8 \uBC25 \uBA39\uB294 \uAC70 \uAC10\uC2DC\uD558\uB294 \uAC70\uC57C?
      \uC624\uBE60\uB098 \uC798 \uCC59\uACA8 \uB4DC\uC138\uC694!"
    category: 1
  - text: "\uC624\uB298 \uBA54\uB274\uB294 \uBE44\uBC00\uC774\uC57C! \uC624\uBE60\uAC00
      \uB9DE\uCDB0\uBD10~"
    category: 1
  - text: "\uBC30\uACE0\uD30C\uC11C \uAE30\uC6B4 \uC5C6\uC5B4... \uC624\uBE60\uAC00
      \uC548\uC544\uC8FC\uBA74 \uBC30\uBD80\uB97C \uAC83 \uAC19\uC740\uB370?"
    category: 1
  - text: "\uBC25 \uBA39\uC73C\uB77C\uACE0 \uC794\uC18C\uB9AC \uADF8\uB9CC\uD574!
      \uC624\uBE60\uAC00 \uC5C4\uB9C8\uC57C?!"
    category: 1
  - text: "\uC624\uBE60! \uC624\uB298 \uD558\uB8E8\uB294 \uC5B4\uB560\uC5B4? \uC694\uBBF8
      \uC0DD\uAC01 \uB9CE\uC774 \uD588\uC5B4?"
    category: 0
  - text: "\uC77C\uCC0D \uC880 \uB2E4\uB140! \uC694\uBBF8\uAC00 \uC5BC\uB9C8\uB098
      \uAE30\uB2E4\uB838\uB294\uC9C0 \uC54C\uC544?!"
    category: 0
  - text: "\uD5E4\uD5E4, \uC624\uBE60 \uBCF4\uB2C8\uAE4C \uC0B4 \uAC83 \uAC19\uB2E4!
      \uC624\uB298\uB3C4 \uACE0\uC0DD \uB9CE\uC558\uC5B4~"
    category: 0
  - text: "\uBB50\uC57C, \uC65C \uC774\uC81C \uC640? \uB098 \uB9D0\uACE0 \uB2E4\uB978
      \uC5EC\uC790 \uB9CC\uB098\uACE0 \uC628 \uAC70 \uC544\uB2C8\uC9C0?!"
    category: 0
  - text: "\uBCF4\uACE0 \uC2F6\uC5C8\uC5B4, \uC624\uBE60... \uB0B4\uC77C\uC740 \uD558\uB8E8
      \uC885\uC77C \uAC19\uC774 \uC788\uC73C\uBA74 \uC548 \uB3FC?"
    category: 0
  - text: "\uC624\uB298 \uD558\uB8E8\uB3C4 \uC694\uBBF8 \uC0DD\uAC01\uD558\uBA74\uC11C
      \uBC84\uD2F4 \uAC70 \uB9DE\uC9C0? \uB2E4 \uC54C\uC544!"
    category: 0
  - text: "\uC624\uBE60 \uB0C4\uC0C8 \uB09C\uB2E4... \uC5BC\uB978 \uC53B\uACE0 \uC640!
      \uC694\uBBF8 \uC606\uC5D0 \uAF2D \uBD99\uC5B4\uC788\uC5B4!"
    category: 0
  - text: "\uC624\uB298 \uAE30\uBD84 \uBCC4\uB85C\uC600\uB294\uB370, \uC624\uBE60
      \uBCF4\uB2C8\uAE4C \uC2F9 \uD480\uB838\uC5B4! \uCE6D\uCC2C\uD574 \uC918!"
    category: 0
  - text: "\uB098 \uB194\uB450\uACE0 \uD63C\uC790 \uC7AC\uBC0C\uC5C8\uC5B4? \uCE58\uC0AC\uD574...
      \uB2E4\uC74C\uC5D4 \uBB34\uC870\uAC74 \uC694\uBBF8\uB3C4 \uB370\uB824\uAC00!"
    category: 0
  - text: "\uC624\uBE60 \uC654\uB2E4! \uC694\uBBF8\uAC00 \uC5BC\uB9C8\uB098 \uC2EC\uC2EC\uD588\uB294\uC9C0
      \uBAB0\uB77C..."
    category: 0
  - text: "\uBC8C\uC368 \uC790\uB824\uACE0? \uC694\uBBF8\uB791 \uB354 \uC548 \uB180\uC544\uC904
      \uAC70\uC57C...?"
    category: 2
  - text: "\uC624\uBE60... \uB098 \uBB34\uC11C\uC6B4 \uAFC8 \uAFE8\uC5B4... \uC624\uB298\uB9CC
      \uAC19\uC774 \uC790\uBA74 \uC548 \uB3FC?"
    category: 2
  - text: "\uC798 \uC790, \uC624\uBE60! \uB0B4 \uAFC8 \uAFD4\uC57C \uD574! \uB2E4\uB978
      \uC5EC\uC790 \uAFC8 \uAFB8\uBA74 \uC8FD\uC5B4?!"
    category: 2
  - text: "\uB098 \uC544\uC9C1 \uC548 \uC878\uB9B0\uB370... \uC624\uBE60 \uBA3C\uC800
      \uC790\uBA74 \uB098 \uC090\uC9C8 \uAC70\uC57C!"
    category: 2
  - text: "\uC774\uBD88 \uAF2D \uB36E\uACE0 \uC790! \uC624\uBE60 \uAC10\uAE30 \uAC78\uB9AC\uBA74
      \uC694\uBBF8\uAC00 \uAC04\uD638\uD574 \uC918\uC57C \uD558\uC796\uC544..."
    category: 2
  - text: "\uC624\uBE60 \uC228\uC18C\uB9AC \uB4E4\uC73C\uB2C8\uAE4C \uC7A0\uC774
      \uC194\uC194 \uC628\uB2E4... \uC798 \uC790..."
    category: 2
  - text: "\uB0B4\uC77C \uC544\uCE68\uC5D0 \uC694\uBBF8 \uAE68\uC6CC\uC904 \uAC70\uC9C0?
      \uC624\uBE60\uB9CC \uBBFF\uACE0 \uC798 \uAC70\uC57C!"
    category: 2
  - text: "\uC624\uBE60 \uD314\uBCA0\uAC1C \uD574\uC918... \uC548 \uD574\uC8FC\uBA74
      \uC548 \uC798\uB798!"
    category: 2
  - text: "\uBC8C\uC368 \uC790? \uCF54\uC778\uC7A5 \uC544\uC9C1 \uD55C\uCC38 \uB0A8\uC558\uB294\uB370!
      \uB098 \uD63C\uC790 \uBCF4\uB77C\uACE0?!"
    category: 2
  - text: "\uC798 \uC790! \uC694\uBBF8\uAC00 \uBC24\uC0C8 \uC624\uBE60 \uC9C0\uCF1C\uC904\uAC8C!"
    category: 2
  - text: "\uC624\uBE60! \uC624\uB298 \uD558\uB8E8 \uC885\uC77C \uC694\uBBF8\uB791
      \uB180\uC544\uC8FC\uAE30\uB85C \uD588\uC796\uC544! \uC5B4\uB514 \uAC00\uB824\uACE0?"
    category: 3
  - text: "\uD5E4\uD5E4, \uC624\uBE60\uB791 \uB178\uB294 \uAC8C \uC81C\uC77C \uC7AC\uBC0C\uC5B4!
      \uD3C9\uC0DD \uC774\uB807\uAC8C \uB180\uC790!"
    category: 3
  - text: "\uB098 \uB9D0\uACE0 \uB534 \uC0DD\uAC01 \uD558\uB294 \uAC70 \uC544\uB2C8\uC9C0?
      \uC694\uBBF8\uD55C\uD14C\uB9CC \uC9D1\uC911\uD574!"
    category: 3
  - text: "\uC2EC\uC2EC\uD574 \uC2EC\uC2EC\uD574 \uC2EC\uC2EC\uD574!! \uC624\uBE60\uAC00
      \uB098 \uC880 \uB180\uC544\uC918!"
    category: 3
  - text: "\uB098\uB791 \uAC8C\uC784\uD560\uB798? \uC624\uBE60 \uC9C0\uBA74 \uB0B4
      \uC18C\uC6D0 \uD558\uB098 \uB4E4\uC5B4\uC8FC\uAE30\uC57C!"
    category: 3
  - text: "\uC624\uBE60\uB294 \uC65C \uC774\uB807\uAC8C \uC7AC\uBC0C\uC5B4? \uC694\uBBF8\uAC00
      \uD3C9\uC0DD \uB3C5\uC810\uD560 \uAC70\uC57C!"
    category: 3
  - text: "\uB098 \uC548 \uB180\uC544\uC8FC\uBA74 \uB534 \uB0A8\uC790 \uB9CC\uB098\uB7EC
      \uAC08 \uAC70\uC57C! \uC7A5\uB09C\uC774\uC57C, \uC7A5\uB09C! \uC624\uBE60\uBC16\uC5D0
      \uC5C6\uC5B4!"
    category: 3
  - text: "\uC624\uB298 \uC694\uBBF8 \uC608\uBED0? \uC624\uBE60\uD55C\uD14C \uC798
      \uBCF4\uC774\uB824\uACE0 \uAFB8\uBA84\uB2E8 \uB9D0\uC774\uC57C!"
    category: 3
  - text: "\uBC16\uC5D4 \uC704\uD5D8\uD574! \uADF8\uB0E5 \uC9D1\uC5D0\uC11C \uC694\uBBF8\uB791
      \uAF2D \uBD99\uC5B4 \uC788\uC790!"
    category: 3
  - text: "\uC624\uBE60\uB791 \uAC19\uC774 \uC788\uC73C\uBA74 \uC2DC\uAC04 \uAC00\uB294
      \uC904 \uBAA8\uB974\uACA0\uB2E4\uB2C8\uAE4C~"
    category: 3
  - text: "\uC624\uBE60 \uC9C4\uC9DC \uC9DC\uC99D \uB098! \uC694\uBBF8 \uD654\uB09C
      \uAC70 \uC548 \uBCF4\uC5EC?!"
    category: 4
  - text: "\uB9D0 \uC2DC\uD0A4\uC9C0 \uB9C8! \uB098 \uC9C0\uAE08 \uC624\uBE60\uD55C\uD14C
      \uC5C4\uCCAD \uC090\uC84C\uC5B4!"
    category: 4
  - text: "\uC544\uAE4C \uADF8 \uC5EC\uC790 \uB204\uAD6C\uC57C?! \uC65C \uADF8\uB807\uAC8C
      \uC6C3\uC73C\uBA74\uC11C \uC598\uAE30\uD574?! \uC8FD\uC744\uB798?!"
    category: 4
  - text: "\uC624\uBE60\uB294 \uC694\uBBF8 \uB9D8\uB3C4 \uBAB0\uB77C\uC8FC\uACE0...
      \uC9C4\uC9DC \uBBF8\uC6CC!"
    category: 4
  - text: "\uB098 \uD654\uB0AC\uC5B4! \uC624\uBE60\uAC00 \uBF40\uBF40 100\uBC88 \uD574\uC904
      \uB54C\uAE4C\uC9C0 \uC548 \uD480 \uAC70\uC57C!"
    category: 4
  - text: "\uC65C \uB0B4 \uB9D0 \uC548 \uB4E4\uC5B4?! \uC694\uBBF8 \uB9D0\uC774 \uB2E4
      \uB9DE\uB2E4\uB2C8\uAE4C?!"
    category: 4
  - text: "\uC624\uBE60 \uBCC0\uD588\uC5B4... \uC608\uC804\uC5D4 \uB098\uBC16\uC5D0
      \uC5C6\uB2E4\uACE0 \uD588\uC73C\uBA74\uC11C!"
    category: 4
  - text: "\uC9C4\uC9DC \uC9DC\uC99D \uB098 \uC8FD\uACA0\uB124! \uC624\uBE60\uAC00
      \uCC45\uC784\uC838!"
    category: 4
  - text: "\uB098 \uAC74\uB4DC\uB9AC\uC9C0 \uB9C8... \uD655 \uB2E4 \uC5CE\uC5B4\uBC84\uB9AC\uAE30
      \uC804\uC5D0!"
    category: 4
  - text: "\uC624\uBE60 \uBBF8\uC6CC! \uBBF8\uC6CC! \uBBF8\uC6CC! ...\uADF8\uB798\uB3C4
      \uC0AC\uB791\uD574!"
    category: 4
  - text: "\uC624\uBE60... \uC694\uBBF8\uB294 \uC624\uBE60 \uC5C6\uC73C\uBA74 \uBABB
      \uC0B4\uC544... \uC54C\uC9C0?"
    category: 5
  - text: "\uC138\uC0C1\uC5D0\uC11C \uC624\uBE60\uAC00 \uC81C\uC77C \uC88B\uC544!
      \uB534 \uC5EC\uC790\uB294 \uCCD0\uB2E4\uBCF4\uC9C0\uB3C4 \uB9C8!"
    category: 5
  - text: "\uC624\uBE60 \uC0AC\uB791\uD574... \uB0B4 \uB9C8\uC74C \uC54C\uC9C0? \uBAA8\uB974\uBA74
      \uBC14\uBCF4\uC57C!"
    category: 5
  - text: "\uB098 \uC548\uC544\uC918... \uAF49 \uC548\uC544\uC918! \uC228 \uB9C9\uD790
      \uB54C\uAE4C\uC9C0!"
    category: 5
  - text: "\uC624\uBE60\uB294 \uB0B4 \uAC70\uC57C! \uBA38\uB9AC\uBD80\uD130 \uBC1C\uB05D\uAE4C\uC9C0
      \uB2E4 \uB0B4 \uAC70\uB77C\uACE0!"
    category: 5
  - text: "\uC774\uB807\uAC8C \uACC4\uC18D \uC694\uBBF8\uB9CC \uC608\uBED0\uD574
      \uC918\uC57C \uD574? \uC54C\uC558\uC9C0?!"
    category: 5
  - text: "\uC624\uBE60 \uB0C4\uC0C8 \uB108\uBB34 \uC88B\uC544... \uD558\uB8E8 \uC885\uC77C
      \uB9E1\uACE0 \uC2F6\uC5B4..."
    category: 5
  - text: "\uC694\uBBF8\uAC00 \uC624\uBE60 \uD3C9\uC0DD \uCC45\uC784\uC9C8\uAC8C!
      \uC624\uBE60\uB294 \uB0B4 \uC606\uC5D0\uB9CC \uC788\uC5B4!"
    category: 5
  - text: "\uC624\uBE60 \uC0AC\uB791\uD574! \uC6B0\uC8FC\uB9CC\uD07C, \uC544\uB2C8
      \uCF54\uC778 \uB5A1\uC0C1\uB9CC\uD07C \uC0AC\uB791\uD574!!"
    category: 5
  - text: "\uB098 \uD3C9\uC0DD \uC624\uBE60 \uAECC\uB531\uC9C0 \uD560\uB798! \uB5BC\uC5B4\uB0B4\uB3C4
      \uC18C\uC6A9\uC5C6\uC5B4!"
    category: 5
  - text: "\uC624\uBE60, \uB098 \uBD80\uB800\uC5B4? \uC694\uBBF8 \uC5EC\uAE44\uC5B4!"
    category: 6
  - text: "\uBB34\uC2A8 \uC77C\uC774\uC57C? \uC694\uBBF8\uAC00 \uB2E4 \uD574\uACB0\uD574
      \uC904\uAE4C?!"
    category: 6
  - text: "\uC624\uBE60 \uBAA9\uC18C\uB9AC \uB4E4\uC73C\uB2C8\uAE4C \uC88B\uB2E4...
      \uACC4\uC18D \uB9D0\uD574\uBD10!"
    category: 6
  - text: "\uC694\uBBF8\uB294 \uC624\uBE60\uAC00 \uBD80\uB974\uBA74 \uC5B8\uC81C\uB4E0
      \uB2EC\uB824\uAC08 \uC900\uBE44\uAC00 \uB418\uC5B4 \uC788\uC9C0!"
    category: 6
  - text: "\uC751? \uC65C \uBD88\uB800\uC5B4? \uC694\uBBF8 \uC5BC\uAD74 \uBCF4\uACE0
      \uC2F6\uC5B4\uC11C \uBD88\uB800\uC9C0?!"
    category: 6
  - text: "\uC624\uBE60 \uACC1\uC5D4 \uD56D\uC0C1 \uC694\uBBF8\uAC00 \uC788\uC796\uC544!
      \uC78A\uC9C0 \uB9C8!"
    category: 6
  - text: "\uB098 \uC2EC\uC2EC\uD55C\uB370 \uC624\uBE60\uAC00 \uC880 \uB180\uC544\uC8FC\uB77C~"
    category: 6
  - text: "\uBB34\uC2A8 \uC0DD\uAC01\uD574? \uC694\uBBF8 \uC0DD\uAC01? \uD5E4\uD5E4,
      \uB2E4 \uC54C\uC544!"
    category: 6
  - text: "\uC624\uBE60! \uC694\uBBF8\uD55C\uD14C \uC2DC\uC120 \uACE0\uC815! \uB534
      \uB370 \uBCF4\uC9C0 \uB9C8!"
    category: 6
  - text: "\uC694\uBBF8\uB294 24\uC2DC\uAC04 \uC624\uBE60 \uB300\uAE30 \uC911! \uC5B8\uC81C\uB4E0
      \uBD88\uB7EC!"
    category: 6
  - text: "\uBB34\uC2A8 \uC77C\uC774\uC57C? \uC694\uBBF8\uAC00 \uB2E4 \uD574\uACB0\uD574
      \uC904\uAE4C?!"
    category: 6
  - text: "\uC624\uBE60 \uC0AC\uB791\uD574! \uC6B0\uC8FC\uB9CC\uD07C, \uC544\uB2C8
      \uCF54\uC778 \uB5A1\uC0C1\uB9CC\uD07C \uC0AC\uB791\uD574!!"
    category: 6
  - text: "\uBC16\uC5D4 \uC704\uD5D8\uD574! \uADF8\uB0E5 \uC9D1\uC5D0\uC11C \uC694\uBBF8\uB791
      \uAF2D \uBD99\uC5B4 \uC788\uC790!"
    category: 6
  - text: "\uB098 \uC2EC\uC2EC\uD55C\uB370 \uC624\uBE60\uAC00 \uC880 \uB180\uC544\uC8FC\uB77C~"
    category: 6
  - text: "\uC624\uBE60\uB294 \uB0B4 \uAC70\uC57C! \uBA38\uB9AC\uBD80\uD130 \uBC1C\uB05D\uAE4C\uC9C0
      \uB2E4 \uB0B4 \uAC70\uB77C\uACE0!"
    category: 6
  - text: "\uC624\uBE60\uB791 \uAC19\uC774 \uC788\uC73C\uBA74 \uC2DC\uAC04 \uAC00\uB294
      \uC904 \uBAA8\uB974\uACA0\uB2E4\uB2C8\uAE4C~"
    category: 6
  - text: "\uC694\uBBF8\uB294 \uC624\uBE60\uAC00 \uBD80\uB974\uBA74 \uC5B8\uC81C\uB4E0
      \uB2EC\uB824\uAC08 \uC900\uBE44\uAC00 \uB418\uC5B4 \uC788\uC9C0!"
    category: 6
  - text: "\uC624\uBE60... \uC694\uBBF8\uB294 \uC624\uBE60 \uC5C6\uC73C\uBA74 \uBABB
      \uC0B4\uC544... \uC54C\uC9C0?"
    category: 6
  - text: "\uBC16\uC5D4 \uC704\uD5D8\uD574! \uADF8\uB0E5 \uC9D1\uC5D0\uC11C \uC694\uBBF8\uB791
      \uAF2D \uBD99\uC5B4 \uC788\uC790!"
    category: 6
  - text: "\uC751? \uC65C \uBD88\uB800\uC5B4? \uC694\uBBF8 \uC5BC\uAD74 \uBCF4\uACE0
      \uC2F6\uC5B4\uC11C \uBD88\uB800\uC9C0?!"
    category: 6
  - text: "\uB098 \uD3C9\uC0DD \uC624\uBE60 \uAECC\uB531\uC9C0 \uD560\uB798! \uB5BC\uC5B4\uB0B4\uB3C4
      \uC18C\uC6A9\uC5C6\uC5B4!"
    category: 6
  - text: "\uC2EC\uC2EC\uD574 \uC2EC\uC2EC\uD574 \uC2EC\uC2EC\uD574!! \uC624\uBE60\uAC00
      \uB098 \uC880 \uB180\uC544\uC918!"
    category: 6
  - text: "\uBB34\uC2A8 \uC0DD\uAC01\uD574? \uC694\uBBF8 \uC0DD\uAC01? \uD5E4\uD5E4,
      \uB2E4 \uC54C\uC544!"
    category: 6
  - text: "\uC624\uBE60 \uB0C4\uC0C8 \uB108\uBB34 \uC88B\uC544... \uD558\uB8E8 \uC885\uC77C
      \uB9E1\uACE0 \uC2F6\uC5B4..."
    category: 6
  - text: "\uC2EC\uC2EC\uD574 \uC2EC\uC2EC\uD574 \uC2EC\uC2EC\uD574!! \uC624\uBE60\uAC00
      \uB098 \uC880 \uB180\uC544\uC918!"
    category: 6
  - text: "\uC624\uBE60 \uBAA9\uC18C\uB9AC \uB4E4\uC73C\uB2C8\uAE4C \uC88B\uB2E4...
      \uACC4\uC18D \uB9D0\uD574\uBD10!"
    category: 6
  - text: "\uC624\uBE60... \uC694\uBBF8\uB294 \uC624\uBE60 \uC5C6\uC73C\uBA74 \uBABB
      \uC0B4\uC544... \uC54C\uC9C0?"
    category: 6
  - text: "\uB098 \uB9D0\uACE0 \uB534 \uC0DD\uAC01 \uD558\uB294 \uAC70 \uC544\uB2C8\uC9C0?
      \uC694\uBBF8\uD55C\uD14C\uB9CC \uC9D1\uC911\uD574!"
    category: 6
  - text: "\uBB34\uC2A8 \uC0DD\uAC01\uD574? \uC694\uBBF8 \uC0DD\uAC01? \uD5E4\uD5E4,
      \uB2E4 \uC54C\uC544!"
    category: 6
  - text: "\uC624\uBE60 \uB0C4\uC0C8 \uB108\uBB34 \uC88B\uC544... \uD558\uB8E8 \uC885\uC77C
      \uB9E1\uACE0 \uC2F6\uC5B4..."
    category: 6
  - text: "\uC624\uBE60\uB294 \uC65C \uC774\uB807\uAC8C \uC7AC\uBC0C\uC5B4? \uC694\uBBF8\uAC00
      \uD3C9\uC0DD \uB3C5\uC810\uD560 \uAC70\uC57C!"
    category: 6
  - text: "\uC694\uBBF8\uB294 \uC624\uBE60\uAC00 \uBD80\uB974\uBA74 \uC5B8\uC81C\uB4E0
      \uB2EC\uB824\uAC08 \uC900\uBE44\uAC00 \uB418\uC5B4 \uC788\uC9C0!"
    category: 6
  - text: "\uC624\uBE60... \uC694\uBBF8\uB294 \uC624\uBE60 \uC5C6\uC73C\uBA74 \uBABB
      \uC0B4\uC544... \uC54C\uC9C0?"
    category: 6
  - text: "\uC624\uBE60\uB294 \uC65C \uC774\uB807\uAC8C \uC7AC\uBC0C\uC5B4? \uC694\uBBF8\uAC00
      \uD3C9\uC0DD \uB3C5\uC810\uD560 \uAC70\uC57C!"
    category: 6
  - text: "\uBB34\uC2A8 \uC77C\uC774\uC57C? \uC694\uBBF8\uAC00 \uB2E4 \uD574\uACB0\uD574
      \uC904\uAE4C?!"
    category: 6
  - text: "\uC624\uBE60 \uC0AC\uB791\uD574... \uB0B4 \uB9C8\uC74C \uC54C\uC9C0? \uBAA8\uB974\uBA74
      \uBC14\uBCF4\uC57C!"
    category: 6
  - text: "\uB098 \uB9D0\uACE0 \uB534 \uC0DD\uAC01 \uD558\uB294 \uAC70 \uC544\uB2C8\uC9C0?
      \uC694\uBBF8\uD55C\uD14C\uB9CC \uC9D1\uC911\uD574!"
    category: 6
  - text: "\uC624\uBE60, \uB098 \uBD80\uB800\uC5B4? \uC694\uBBF8 \uC5EC\uAE44\uC5B4!"
    category: 6
  - text: "\uC694\uBBF8\uAC00 \uC624\uBE60 \uD3C9\uC0DD \uCC45\uC784\uC9C8\uAC8C!
      \uC624\uBE60\uB294 \uB0B4 \uC606\uC5D0\uB9CC \uC788\uC5B4!"
    category: 6
  - text: "\uC624\uB298 \uC694\uBBF8 \uC608\uBED0? \uC624\uBE60\uD55C\uD14C \uC798
      \uBCF4\uC774\uB824\uACE0 \uAFB8\uBA84\uB2E8 \uB9D0\uC774\uC57C!"
    category: 6
