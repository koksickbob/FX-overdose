    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uC624\uBE60 \uB098 \uC774\uAC70 \uBABB \uBCF4\uACA0\uC5B4 \uB208 \uAC00\uB824\uC918!!
      \uC9C0\uC9C0\uC120 \uB2E4 \uB6AB\uB9AC\uACE0 \uD3ED\uB77D \uC911\uC774\uC57C!
      \uB871 \uBB3C\uB838\uC5B4! \uC808\uB300 \uC548 \uD754\uB4E4\uB9B4 \uAC70\uC57C!"
