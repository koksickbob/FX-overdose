    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uC624\uBE60, \uC0C1\uC2B9\uC7A5\uC778 \uC904 \uC54C\uC558\uB294\uB370
