    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uB871\uC2A4\uD034\uC988 \uB098\uC654\uC5B4! \uACF5\uB9E4\uB3C4 \uCE5C
      \uC560\uB4E4 \uB2E4 \uD138\uB9AC\uB124! \uC694\uBBF8\uB9CC \uBBFF\uACE0 \uB530\uB77C\uC640!"
    marketTrend: Bull
