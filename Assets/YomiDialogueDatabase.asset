  entries:
  - text: "\uB0B4 \uC20F \uD3EC\uC9C0\uC158... \uBE68\uAC1B\uAC8C \uD0C0\uB4E4\uC5B4
      \uAC00\uACE0 \uC788\uC5B4 \uC624\uBE60...!!"
    marketTrend: Sideways
    mentalState: Focused
    position: Short
    requiredDirection: 2
    isProfit: 0
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uC0C1\uC2B9\uC7A5 \uC81C\uB300\uB85C \uD0D4\uC5B4! \uD558\uB298 \uB6AB\uACE0
      \uC62C\uB77C\uAC00\uB124!! {leverage}\uBC30\uB85C \uB561\uAE30\uAE38 \uC798\uD588\uC9C0?!
      \uC624\uBE60 \uB098 \uC9C4\uC9DC \uCC9C\uC7AC\uC778\uAC00 \uBD10!!"
    marketTrend: Volatile
    mentalState: Relieved
    position: Long
    requiredDirection: 1
    isProfit: 1
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uC624\uBE60 \uC27F... \uC9C0\uAE08 \uC644\uBCBD\uD55C \uC218\uB834 \uB05D\uC790\uB77D\uC774\uC57C.
      \uBE54 \uC3D8\uAE30 \uC9C1\uC804\uC774\uB2C8\uAE4C \uC870\uC6A9\uD788 {leverage}\uBC30\uB85C
      \uD0C0\uC810 \uC7A1\uC558\uC5B4. \uB0B4 \uCC28\uD2B8 \uBD84\uC11D\uC740 \uC808\uB300
      \uC548 \uD2C0\uB824.~"
    marketTrend: Bear
    mentalState: Focused
    position: Long
    requiredDirection: 1
    isProfit: 0
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uBA38\uB9AC\uAC00 \uBE59\uBE59 \uB3CC\uC544! \uC774\uAC70\uC9C0! \uB871\uC740
      \uC5B8\uC81C\uB098 \uC633\uB2E4\uB2C8\uAE4C!"
    marketTrend: Volatile
    mentalState: Manic
    position: Long
    requiredDirection: 0
    isProfit: 1
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uC624\uBE60 \uB098 \uAC74\uB4E4\uC9C0 \uB9C8 \uC9C0\uAE08 \uD3ED\uBC1C\uD558\uAE30
      \uC9C1\uC804\uC774\uB2C8\uAE4C!! \uC544 \uC20F \uCCE4\uB294\uB370 \uC65C \uC548
      \uB5A8\uC5B4\uC838! \uC800\uD56D\uC120 \uB6AB\uB838\uC5B4!..."
    marketTrend: Bull
    mentalState: Furious
    position: Short
    requiredDirection: 2
    isProfit: 0
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uC9C0\uAE08 \uD638\uAC00\uCC3D \uC774\uC0C1\uD574. \uC9C0\uAE08 \uCC28\uD2B8
      \uC644\uC804 \uC9C0\uB8B0\uBC2D\uC774\uC57C. \uC548 \uB4E4\uC5B4\uAC00\uB294
      \uAC8C \uB3C8 \uBC84\uB294 \uAC70\uC57C. \uAC00\uBCF4\uC790\uACE0!!"
    marketTrend: Volatile
    mentalState: Focused
    position: None
    requiredDirection: 0
    isProfit: 0
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uB3C4\uC9C0\uCF54\uC778\uB3C4 \uC544\uB2C8\uACE0 \uC65C \uC5EC\uAE30\uC11C
      \uBE54\uC744 \uC3D8\uB0D0\uACE0! \uBA38\uC2A4\uD06C \uB610 \uD5DB\uC18C\uB9AC\uD588\uC5B4?!"
    marketTrend: 
    mentalState: Panicked
    position: None
    requiredDirection: 0
    isProfit: 0
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uC218\uC775 \uB2E4 \uB193\uCCE4\uC5B4 \uC9DC\uC99D \uB098... \uC591\uBD09
      \uC5F0\uC18D\uC73C\uB85C \uCF1C\uC9C0\uB2C8\uAE4C \uC2EC\uC7A5 \uBA48\uCD9C
      \uAC83 \uAC19\uC544... \uC9C4\uC9DC \uD30C\uC0B0\uD558\uAE30 \uC9C1\uC804\uC774\uC57C...
      \uBBF8\uCCE4\uC5B4 100\uBC34\uB370 \uC65C \uB5A8\uC5B4\uC838!! \uC0B4\uB824\uC8FC\uC138\uC694
      \uC81C\uBC1C...!!"
    marketTrend: Sideways
    mentalState: Regretful
    position: Short
    requiredDirection: 1
    isProfit: 0
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uD750\uC5B4\uC5C9... \uC624\uBE60 \uB0B4 \uB3C8... \uB0B4 \uB3C8 \uC5B4\uB5A1\uD574...
      \uC228 \uB9C9\uD600... \uC591\uBD09\uC774 \uB05D\uB3C4 \uC5C6\uC774 \uAE38\uC5B4\uC9C0\uACE0
      \uC788\uC5B4... \uAC00\uBCF4\uC790\uACE0!! \uBBF8\uCCE4\uC5B4 100\uBC34\uB370
      \uC65C \uB5A8\uC5B4\uC838!! \uC0B4\uB824\uC8FC\uC138\uC694 \uC81C\uBC1C...!!"
    marketTrend: Bull
    mentalState: Tearful
    position: Short
    requiredDirection: 1
    isProfit: 0
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uC544\uD558\uD558! \uB2E4 \uD0C0\uBC84\uB824\uB77C! \uC544\uD558\uD558!
      \uC20F\uCDA9\uC774\uB4E4 \uCCAD\uC0B0 \uB2F9\uD558\uB294 \uC18C\uB9AC \uC5EC\uAE30\uAE4C\uC9C0
      \uB4E4\uB9B0\uB2E4! \uB05D\uAE4C\uC9C0 \uC950\uC5B4\uC9DC\uC11C \uBC1C\uB77C\uBA39\uC790!
      {leverage}\uBC30\uB85C \uB561\uAE30\uAE38 \uC798\uD588\uC9C0?! \uC624\uBE60 \uB098
      \uC9C4\uC9DC \uCC9C\uC7AC\uC778\uAC00 \uBD10!! \uB0B4 \uCC28\uD2B8 \uBD84\uC11D\uC740
      \uC808\uB300 \uC548 \uD2C0\uB824!"
    marketTrend: Bull
    mentalState: Manic
    position: Long
    requiredDirection: 0
    isProfit: 1
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uC544 \uC544\uAE4C \uADF8 \uC790\uB9AC\uC5D0\uC11C \uD0D4\uC5B4\uC57C
      \uD588\uB294\uB370! \uC5EC\uAE30\uC11C \uB354 \uBE60\uC9C0\uBA74 \uC9C4\uC9DC
      \uCCAD\uC0B0\uC778\uB370... \uC5B4\uB5A1\uD574... \uAC00\uBCF4\uC790\uACE0!!
      \uB9D0\uB3C4 \uC548 \uB3FC... \uB0B4 \uC5D8\uB9AC\uC5B4\uD2B8 \uD30C\uB3D9\uC774
      \uD2C0\uB838\uB2E4\uACE0?!"
    marketTrend: Bear
    mentalState: Regretful
    position: Long
    requiredDirection: 0
    isProfit: 0
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uC138\uB825 \uAC1C\uC790\uC2DD\uB4E4 \uC9C4\uC9DC \uAC00\uB9CC \uC548
      \uB46C!! \uC624\uBE60 \uB098 \uC9C0\uAE08 \uCC28\uD2B8 \uD30C\uB797\uAC8C \uC9C8\uB9B0
      \uAC70 \uBCF4\uACE0 \uD1A0\uD560 \uAC70 \uAC19\uC544... \uC2EC\uC7A5 \uD130\uC9C8
      \uAC83 \uAC19\uC544 \uBBF8\uCE58\uACA0\uC5B4! {leverage}\uBC30\uB85C \uBB3C\uB838\uC5B4...
      \uC624\uBE60\uAC00 \uD558\uB77C\uBA70!! \uC65C \uC774\uB807\uAC8C \uB41C \uAC70\uC57C!!
      \uBD84\uBA85\uD788 \uBC18\uB4F1 \uC790\uB9AC\uC778\uB370 \uC138\uB825\uC774
      \uC5B5\uC9C0\uB85C \uBBF8\uB294 \uAC70\uC57C!!"
    marketTrend: Bear
    mentalState: Furious
    position: Long
    requiredDirection: 0
    isProfit: 0
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uC624\uBE60 \uB098 \uBA38\uB9AC \uC4F0\uB2E4\uB4EC\uC5B4 \uC918. \uC624\uBE60
      \uC6B0\uB9AC \uC774 \uB3C8\uC73C\uB85C \uBB50 \uD560\uAE4C?! \uC775\uC808\uD558\uB2C8\uAE4C
      \uB108\uBB34 \uD589\uBCF5\uD574!"
    marketTrend: 
    mentalState: Pleased
    position: None
    requiredDirection: 0
    isProfit: 0
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uAC70\uB798\uB7C9 \uD130\uC9C0\uAE30 \uC9C1\uC804\uC774\uC57C. \uACF5\uB9E4\uB3C4
      \uB300\uBC15 \uB0AC\uC5B4! \uC74C\uBD09 \uC3DF\uC544\uC9C0\uBA74\uC11C \uB69D\uBC30\uAE30
      \uB2E4 \uAE68\uC838! \uC2EC\uC7A5 \uD130\uC9C8 \uAC83 \uAC19\uC544 \uBBF8\uCE58\uACA0\uC5B4!"
    marketTrend: Bear
    mentalState: Focused
    position: Short
    requiredDirection: 2
    isProfit: 1
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uC6B0\uB9AC \uB108\uBB34 \uC77C\uCC0D \uB0B4\uB9B0 \uAC70 \uC544\uB2C8\uC57C?
      \uC870\uAE08\uB9CC \uB354... \uC644\uBCBD\uD55C \uC790\uB9AC\uAC00 \uC62C \uB54C\uAE4C\uC9C0
      \uAE30\uB2E4\uB9B4 \uAC70\uC57C."
    marketTrend: Sideways
    mentalState: Regretful
    position: None
    requiredDirection: 0
    isProfit: 0
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uC694\uBBF8 \uBC84\uB9AC\uBA74 \uC548 \uB3FC \uC624\uBE60. \uAC70\uB300\uD55C
      \uC74C\uBD09 \uD3ED\uD3EC\uC218\uAC00 \uB5A8\uC5B4\uC9C0\uACE0 \uC788\uC5B4!
      \uC20F \uC218\uC775 \uB2EC\uB2EC\uD574!"
    marketTrend: Bear
    mentalState: Affectionate
    position: Short
    requiredDirection: 2
    isProfit: 1
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uD638\uAC00\uCC3D \uBC30\uC5F4\uC774 \uC778\uC704\uC801\uC774\uC57C \uC624\uBE60.
      \uC6B0\uB9AC\uAC00 \uC7A1\uC740 \uB871 \uD0C0\uC810\uC5D0\uC11C \uBD88\uAE30\uB465
      \uD130\uC84C\uC5B4! \uAC00\uBCF4\uC790\uACE0!! \uB0B4\uAC00 \uBB50\uB7AC\uC5B4?
      \uCC28\uD2B8 \uB2E4 \uC77D\uC5C8\uB2E4\uB2C8\uAE4C."
    marketTrend: Bull
    mentalState: Suspicious
    position: Long
    requiredDirection: 1
    isProfit: 1
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uC624\uBE60 \uC9C4\uC9DC \uACE0\uB9C8\uC6CC... \uC624\uBE60 \uC6B0\uB9AC\uAC00
      \uD0D4\uB354\uB2C8 \uBC14\uB85C \uB85C\uCF13 \uBC1C\uC0AC\uD558\uC796\uC544!
      \uC624\uBE60 \uB3C8 \uBCF5\uC0AC\uAE30 \uD480\uAC00\uB3D9!! \uC6B0\uB9AC \uC601\uC6D0\uD788
      \uD568\uAED8\uD558\uC790!!"
    marketTrend: Volatile
    mentalState: Relieved
    position: Long
    requiredDirection: 1
    isProfit: 1
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uD558\uC544... \uC9C4\uC9DC \uC798 \uD314\uC558\uC5B4! \uC800\uAE30\uC11C
      \uB354 \uB4E4\uACE0 \uC788\uC5C8\uC73C\uBA74 \uC6B0\uB9AC \uC9C4\uC9DC \uCCAD\uC0B0\uB2F9\uD588\uC5B4!"
    marketTrend: 
    mentalState: Relieved
    position: None
    requiredDirection: 0
    isProfit: 0
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uD558! \uC774 \uBA4D\uCCAD\uD55C \uC138\uB825 \uB188\uB4E4! \uBED4\uD55C
      \uC18D\uC784\uC218\uC5D0 \uB0B4\uAC00 \uB2F9\uD560 \uC904 \uC54C\uC558\uC5B4?!
      \uC644\uBCBD\uD558\uAC8C \uAC04\uD30C\uD558\uACE0 \uBC18\uB300\uB85C {leverage}\uBC30
      \uAF42\uC544\uBC84\uB838\uC9C0! \uB3C4\uD30C\uBBFC \uD3ED\uBC1C\uD55C\uB2E4
      \uC9C4\uC9DC! \uC624\uBE60 \uB098 \uCC9C\uC7AC \uB9DE\uC9C0?!!!"
    marketTrend: Volatile
    mentalState: Manic
    position: Short
    requiredDirection: 0
    isProfit: 0
    requiredLeverage: 0
    requiredHeroLevel: 0
    requiredSkillLevel: 0
    isHighMarginRisk: 0
    eventCategory: 
  - text: "\uC624\uBE60, \uC0C1\uC2B9\uC7A5\uC778 \uC904 \uC54C\uC558\uB294\uB370
      \uC644\uBCBD\uD558\uAC8C \uB09A\uC600\uC5B4! \uB098 \uC9C0\uAE08 \uBA48\uCD9C
