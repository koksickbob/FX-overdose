    eventCategory: 
  - text: "\uC9C0\uAE08 \uD0C0\uC810 \uC7A1\uC73C\uBA74 \uD640\uC9DD \uB3C4\uBC15\uC774\uB098
      \uB2E4\uB984\uC5C6\uC5B4. \uB9E4\uC758 \uB208\uC73C\uB85C \uC9C0\uCF1C\uBCF4\uB294
